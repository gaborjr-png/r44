{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Géppark', 'Machinery') }}{% endblock %}
{% block content %}

{# Manufacturer and controller breakdown of the CNC / NC machines #}
{% set brands = {} %}{% set ctrls = {} %}
{% for g in machines if g.key in ('auto', 'lathe', 'vmc', 'nc') %}{% for it in g['items'] %}
  {% set b = brand(it.model) %}
  {% set _x = brands.update({b: brands.get(b, 0) + it.qty}) %}
  {% set c = it.ctrl.split(' ')[0] %}
  {% set _y = ctrls.update({c: ctrls.get(c, 0) + it.qty}) %}
{% endfor %}{% endfor %}
{% set brand_max = brands.values() | max %}
{% set ctrl_max = ctrls.values() | max %}

{{ m.page_head(_('Géppark', 'Machinery'),
   _(totals.all ~ ' gép egy telephelyen', totals.all ~ ' machines on one site'),
   _('CNC automata esztergák, két revolverfejes ellenorsós esztergák és vertikális megmunkálóközpontok – INDEX, STAR, Mori Seiki, Nakamura, Takisawa, Akira Seiki, OKK és Bridgeport gépek Fanuc, Heidenhain, Mitsubishi és Sinumerik vezérlőkkel, amelyeket NC és hagyományos gépek egészítenek ki.', 'CNC automatic lathes, twin-turret sub-spindle lathes and vertical machining centres – INDEX, STAR, Mori Seiki, Nakamura, Takisawa, Akira Seiki, OKK and Bridgeport machines with Fanuc, Heidenhain, Mitsubishi and Sinumerik controls, complemented by NC and conventional machines.'),
   'star-sr16.webp', 'bushing:brass',
   [(_('CNC eszterga', 'CNC lathes'), totals.cnc_lathes),
    (_('Megmunkálóközpont', 'Machining centres'), totals.centres),
    (_('NC eszterga', 'NC lathes'), machines[3].total),
    (_('Hagyományos gép', 'Conventional'), machines[5].total)], pos='70% 45%') }}

<section class="section">
  <div class="wrap">
    <div class="mpark" data-mpark>
      <aside class="mpark__side">
        <h2 class="mpark__h">{{ _('Gyártók szerint', 'By manufacturer') }}</h2>
        <ul class="brandbars">
          {% for b, n in brands | dictsort(by='value', reverse=true) %}
          <li><button type="button" data-brand="{{ b }}" aria-pressed="false">
            <span class="brandbars__name">{{ b }}</span>
            <span class="brandbars__track"><span style="width: {{ (n / brand_max * 100) | round(1) }}%"></span></span>
            <span class="brandbars__n">{{ n }}</span>
          </button></li>
          {% endfor %}
        </ul>
        <h2 class="mpark__h mpark__h--gap">{{ _('Vezérlők szerint', 'By control') }}</h2>
        <ul class="brandbars">
          {% for c, n in ctrls | dictsort(by='value', reverse=true) %}
          <li><button type="button" data-ctrl="{{ c }}" aria-pressed="false">
            <span class="brandbars__name">{{ c }}</span>
            <span class="brandbars__track"><span style="width: {{ (n / ctrl_max * 100) | round(1) }}%"></span></span>
            <span class="brandbars__n">{{ n }}</span>
          </button></li>
          {% endfor %}
        </ul>
        <p class="mpark__note">{{ _('Kattintson egy sávra a szűréshez. CNC és NC gépek.', 'Click a bar to filter. CNC and NC machines.') }}</p>
      </aside>

      <div class="mpark__main">
        <div class="mpark__tools">
          <div class="chips" role="group" aria-label="{{ _('Kategória', 'Category') }}">
            <button type="button" class="chip" data-group="" aria-pressed="true">{{ _('Összes', 'All') }} <span>{{ totals.all }}</span></button>
            {% for g in machines %}
            <button type="button" class="chip" data-group="{{ g.key }}" aria-pressed="false">{{ g[lang] }} <span>{{ g.total }}</span></button>
            {% endfor %}
          </div>
          <label class="search">
            <span class="sr-only">{{ _('Keresés', 'Search') }}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.6"/></svg>
            <input type="search" id="mSearch" placeholder="{{ _('Keresés: pl. STAR, Fanuc, ellenorsós, köszörű…', 'Search: e.g. STAR, Fanuc, sub-spindle, grinder…') }}" autocomplete="off">
          </label>
        </div>

        <p class="mpark__count" aria-live="polite"><strong id="mCount">{{ totals.all }}</strong> <span>{{ _('gép', 'machines') }}</span> <button type="button" class="mpark__reset" id="mReset" hidden>{{ _('Szűrés törlése', 'Clear filters') }}</button></p>

        <div class="table-wrap">
          <table class="table table--machines" id="mTable">
            <thead>
              <tr>
                <th scope="col">{{ _('Típus', 'Model') }}</th>
                <th scope="col">{{ _('Kivitel', 'Type') }}</th>
                <th scope="col">{{ _('Vezérlő', 'Control') }}</th>
                <th scope="col" class="num">{{ _('db', 'qty') }}</th>
              </tr>
            </thead>
            {% for g in machines %}
            <tbody data-group="{{ g.key }}">
              <tr class="table__group"><th colspan="4" scope="rowgroup">{{ g[lang] }} <span>{{ g.total }} {{ _('db', 'units') }}</span></th></tr>
              {% for it in g['items'] %}
              <tr data-group="{{ g.key }}" data-brand="{{ brand(it.model) }}" data-ctrl="{{ it.ctrl.split(' ')[0] }}" data-qty="{{ it.qty }}">
                <th scope="row">{{ it.model }}</th>
                <td>{{ it[lang] }}</td>
                <td>{% if it.ctrl not in ('–', 'NC') %}<span class="ctrl ctrl--{{ it.ctrl.split(' ')[0] | lower }}">{{ it.ctrl }}</span>{% else %}{{ it.ctrl }}{% endif %}</td>
                <td class="num">{{ it.qty }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endfor %}
          </table>
          <p class="mpark__empty" id="mEmpty" hidden>{{ _('Nincs a keresésnek megfelelő gép.', 'No machines match your search.') }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Üzem', 'Plant') }}</p>
        <h2 class="h2">{{ _('Betekintés a gyártásba', 'Inside our production') }}</h2>
      </div>
    </div>
    <div class="gallery">
      {{ m.photo('star-sr16.webp', _('STAR SR 16 automata eszterga a verpeléti üzemben', 'STAR SR 16 automatic lathe in the Verpelét plant'), 'gallery__wide', '21/9', pos='50% 55%', zoom=1) }}
      {{ m.photo('star-sr16.webp', _('Fanuc vezérlés', 'Fanuc control'), '', '4/3', pos='30% 20%', zoom=1.9) }}
      {{ m.photo('star-sr16.webp', _('Esztergált acél és sárgaréz alkatrészek', 'Turned steel and brass parts'), '', '4/3', pos='50% 88%', zoom=1.8) }}
      {{ m.photo('alkatreszek-maras.webp', _('Vertikális megmunkálóközpont', 'Vertical machining centre'), '', '4/3', pos='28% 18%', zoom=1.7) }}
      {{ m.photo('alkatreszek-maras.webp', _('Mart alkatrészek', 'Milled parts'), '', '4/3', pos='75% 55%', zoom=1.6) }}
    </div>
  </div>
</section>

{% endblock %}
