{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('CNC forgácsolt fém alkatrészek gyártása', 'CNC machined metal components') }}{% endblock %}
{% block content %}

{% set ops = [
  ('face',    _('Homlokesztergálás', 'Facing')),
  ('rough',   _('Nagyolás', 'Roughing')),
  ('drill',   _('Fúrás', 'Drilling')),
  ('finish',  _('Simítás', 'Finishing')),
  ('groove',  _('Beszúrás', 'Grooving')),
  ('thread',  _('Menetvágás', 'Threading')),
  ('cutoff',  _('Leszúrás', 'Parting off')),
  ('inspect', _('Kész alkatrész', 'Finished part')),
] %}

<section class="hero" id="hero">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__top">
    <div>
      <p class="eyebrow eyebrow--light">{{ _('CNC forgácsolt fém alkatrészek gyártása · 1997 óta', 'CNC machined metal components · since 1997') }}</p>
      <h1 class="hero__title">
        <span class="line"><span>{{ _('Precízió,', 'Precision,') }}</span></span>
        <span class="line"><span>{{ _('millió darabban', 'measured in') }}</span></span>
        <span class="line line--muted"><span>{{ _('mérve.', 'millions.') }}</span></span>
      </h1>
    </div>
    <div class="hero__aside">
      <p class="hero__lead">{{ _('Több mint 20 éve a beszállítói piacon, 70 000 000 eladott termékkel. Közép- és nagysorozatú esztergált és mart alkatrészek az elektronika, a járműipar és a pneumatika számára.', 'More than 20 years in the supplier market and 70,000,000 parts sold. Medium and large series of turned and milled components for electronics, automotive and pneumatics.') }}</p>
      <div class="hero__actions">
        <a class="btn btn--brass btn--lg" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatkérés', 'Request a quote') }}<span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost-light btn--lg" href="#alkatreszek">{{ _('Alkatrészek', 'Parts') }}</a>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="console" id="sim">
      <div class="console__stage">
        <canvas class="console__canvas" id="simCanvas" role="img" aria-label="{{ _('Valós idejű 3D esztergálási szimuláció a mellette futó CNC programmal', 'Real-time 3D turning simulation driven by the CNC program alongside') }}"></canvas>
        <div class="console__fallback"><img src="{{ asset }}img/hero-csarnok.jpg" alt="" data-render="bushing:brass"></div>
        <div class="console__badge"><span class="live"></span>{{ _('Valós idejű szimuláció', 'Real-time simulation') }}</div>
        <p class="console__hint">{{ _('Húzza a forgatáshoz', 'Drag to rotate') }}</p>
        <div class="console__mats" role="radiogroup" aria-label="{{ _('Anyag', 'Material') }}">
          <button type="button" role="radio" aria-checked="true" data-mat="brass"><i class="sw sw--brass"></i>CuZn39Pb3</button>
          <button type="button" role="radio" aria-checked="false" data-mat="alu"><i class="sw sw--alu"></i>AlCuMgPb</button>
          <button type="button" role="radio" aria-checked="false" data-mat="pom"><i class="sw sw--pom"></i>POM-C</button>
        </div>
      </div>

      <aside class="console__side" aria-label="{{ _('CNC vezérlő', 'CNC control') }}">
        <div class="ctrl__head">
          <span>FANUC 0i-TF</span><span>O4471</span>
          <button type="button" class="ctrl__btn" id="simToggle" data-play="▶ Cycle start" data-pause="❚❚ Feed hold">❚❚ Feed hold</button>
        </div>
        <dl class="dro" id="dro">
          <div><dt>X</dt><dd data-k="x">200.000</dd></div>
          <div><dt>Z</dt><dd data-k="z">150.000</dd></div>
          <div><dt>S</dt><dd data-k="s">0</dd></div>
          <div><dt>F</dt><dd data-k="f">0.000</dd></div>
          <div><dt>T</dt><dd data-k="t">T0000</dd></div>
          <div><dt>M</dt><dd data-k="m">M09</dd></div>
        </dl>
        <div class="nc" id="nc" tabindex="0" aria-label="{{ _('NC program', 'NC program') }}"><ol id="ncList"></ol></div>
        <p class="ctrl__part">{{ _('Alkatrész: M20×1,5 menetes persely, Ø30 × 50 mm, O-gyűrű horonnyal, Ø10 átmenő furattal', 'Part: M20×1.5 threaded bushing, Ø30 × 50 mm, O-ring groove, Ø10 through bore') }}</p>
      </aside>

      <ol class="console__ops" id="simOps">
        {% for key, label in ops %}
        <li data-op="{{ key }}"><button type="button"><span>{{ '%02d' % loop.index }}</span>{{ label }}</button></li>
        {% endfor %}
      </ol>
      <div class="console__bar"><span id="simBar"></span></div>
    </div>
  </div>

  <div class="hero__facts">
    <dl class="wrap facts">
      <div><dt>{{ _('Eladott termék', 'Parts sold') }}</dt><dd><span data-count="70">70</span>&nbsp;M+</dd></div>
      <div><dt>{{ _('CNC eszterga', 'CNC lathes') }}</dt><dd><span data-count="{{ totals.cnc_lathes }}">{{ totals.cnc_lathes }}</span></dd></div>
      <div><dt>{{ _('Megmunkálóközpont', 'Machining centres') }}</dt><dd><span data-count="{{ totals.centres }}">{{ totals.centres }}</span></dd></div>
      <div><dt>{{ _('Munkatárs', 'Employees') }}</dt><dd><span data-count="50">50</span></dd></div>
      <div><dt>{{ _('Munkarend', 'Operation') }}</dt><dd>{{ _('3 műszak', '3 shifts') }}</dd></div>
    </dl>
  </div>
</section>

<section class="brands" aria-label="{{ _('Gépparkunk gyártói', 'Machine manufacturers in our plant') }}">
  <div class="wrap brands__inner">
    <p class="brands__label">{{ _('Gépparkunk', 'Our machine park') }}</p>
    <ul class="brands__list">
      <li>INDEX</li><li>STAR</li><li>MORI SEIKI</li><li>NAKAMURA</li><li>TAKISAWA</li><li>AKIRA SEIKI</li><li>BRIDGEPORT</li><li>OKK</li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap intro">
    <div class="intro__text">
      <p class="eyebrow">{{ _('A vállalatról', 'The company') }}</p>
      <p class="statement__text reveal">{{ _('Cégünk vevőcentrikus. Maximálisan törekszünk arra, hogy az általunk elvégzett munka a lehető legjobb minőségben, a megadott határidőn belül és a vevői igényeknek minden téren megfeleljen.', 'We are customer-centric. We strive to ensure that our work is of the highest possible quality, delivered on time and meets customer requirements in every respect.') }}</p>
      <p>{{ _('1997-ben családi vállalkozásként, 3 fővel, egy 200 m²-es verpeléti műhelyben indultunk. Ma 50 munkatárssal, 3 műszakban, 27 000 m²-es saját telephelyen gyártunk – partnereinknek a teljes folyamatot biztosítva az alapanyag beszerzésétől a késztermék kiszállításáig.', 'We started in 1997 as a family business with 3 people in a 200 m² workshop in Verpelét. Today 50 employees produce in 3 shifts on our own 27,000 m² site – covering the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}</p>
      <a class="link-arrow" href="{{ href('about') }}">{{ _('A cég története', 'Our history') }}</a>
    </div>
    <figure class="intro__photo reveal">
      <img src="{{ asset }}img/telephely.webp" alt="{{ _('A Steel Riders Kft. üzemépülete Verpeléten', 'Steel Riders Kft. plant building in Verpelét') }}" loading="lazy" width="1536" height="1024">
      <figcaption>3351 Verpelét, Kossuth út 64.</figcaption>
    </figure>
  </div>
</section>

<section class="section section--dark" id="alkatreszek">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--light">{{ _('Jellemző alkatrészek', 'Typical components') }}</p>
        <h2 class="h2">{{ _('Munkahengerek, dugattyúk, szelepek – és még sok más', 'Cylinders, pistons, valves – and much more') }}</h2>
      </div>
      <p>{{ _('Forgassa meg a modelleket. Jellemző alkatrésztípusok a gépészet, pneumatika és hidraulika, a járműipar és az elektronika területéről.', 'Rotate the models. Typical component types from mechanical engineering, pneumatics and hydraulics, automotive and electronics.') }}</p>
    </div>

    <div class="viewer" id="viewer">
      <div class="viewer__list" role="tablist" aria-label="{{ _('Alkatrészek', 'Parts') }}">
        {% set parts = [
          ('bushing',  _('Menetes persely', 'Threaded bushing'),        _('CuZn39Pb3 · esztergálás, fúrás, menetvágás', 'CuZn39Pb3 · turning, drilling, threading')),
          ('piston',   _('Hidraulikus dugattyú', 'Hydraulic piston'),   _('Acél · tömítés- és vezetőgyűrű-hornyok', 'Steel · seal and guide-ring grooves')),
          ('spool',    _('Pneumatikus szeleptolattyú', 'Pneumatic valve spool'), _('Acél · 4 vezérlőél, M8 menet', 'Steel · 4 control lands, M8 thread')),
          ('fitting',  _('Hatlapú csatlakozó', 'Hex fitting'),          _('Sárgaréz · SW22, G1/4 menet', 'Brass · SW22, G1/4 thread')),
          ('flange',   _('Munkahenger-fedél', 'Cylinder end cap'),      _('Alumínium · 6 furat, O-gyűrű horony', 'Aluminium · 6 holes, O-ring groove')),
          ('manifold', _('Szelepblokk', 'Valve manifold'),              _('Alumínium · marás, süllyesztések', 'Aluminium · milling, counterbores')),
        ] %}
        {% for key, name, meta in parts %}
        <button type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-part="{{ key }}">
          <span class="viewer__n">{{ '%02d' % loop.index }}</span>
          <span class="viewer__name">{{ name }}</span>
          <span class="viewer__meta">{{ meta }}</span>
        </button>
        {% endfor %}
      </div>
      <div class="viewer__stage">
        <canvas id="viewerCanvas" role="img" aria-label="{{ _('Forgatható 3D alkatrész', 'Rotatable 3D part') }}"></canvas>
        <p class="console__hint">{{ _('Húzza a forgatáshoz', 'Drag to rotate') }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Tevékenység', 'Activities') }}</p>
        <h2 class="h2">{{ _('CNC megmunkálás és általános fémforgácsolás', 'CNC machining and general metal cutting') }}</h2>
      </div>
      <p>{{ _('Termelésünk gerincét ' ~ totals.cnc_lathes ~ ' CNC eszterga és ' ~ totals.centres ~ ' megmunkálóközpont adja, NC csúcsesztergákkal és hagyományos gépekkel kiegészülve.', 'Our production is built on ' ~ totals.cnc_lathes ~ ' CNC lathes and ' ~ totals.centres ~ ' machining centres, complemented by NC centre lathes and conventional machines.') }}</p>
    </div>

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="{{ _('Technológiák', 'Technologies') }}">
        <button role="tab" id="t-turn" aria-controls="p-turn" aria-selected="true"><span>01</span>{{ _('CNC esztergálás', 'CNC turning') }}</button>
        <button role="tab" id="t-mill" aria-controls="p-mill" aria-selected="false" tabindex="-1"><span>02</span>{{ _('CNC marás', 'CNC milling') }}</button>
        <button role="tab" id="t-cast" aria-controls="p-cast" aria-selected="false" tabindex="-1"><span>03</span>{{ _('Öntvény-megmunkálás', 'Casting machining') }}</button>
        <button role="tab" id="t-gen" aria-controls="p-gen" aria-selected="false" tabindex="-1"><span>04</span>{{ _('Általános fémforgácsolás', 'General machining') }}</button>
      </div>
      <div class="tabs__panel" role="tabpanel" id="p-turn" aria-labelledby="t-turn">
        {{ m.photo('cnc-esztergalas.jpg', _('Esztergált sárgaréz alkatrész', 'Turned brass component'), ratio='4/3', render='fitting:brass') }}
        <div class="tabs__body">
          <h3 class="h3">{{ _('Közép- és nagysorozat nagy pontossággal', 'Medium and large series, high precision') }}</h3>
          <p>{{ _('Alkatrészgyártás CNC automata esztergákon és hosszesztergákon, kiemelten alumínium, sárgaréz és műanyag alkatrészek.', 'Component production on CNC automatic and Swiss-type lathes, with a focus on aluminium, brass and plastic parts.') }}</p>
          <dl class="specs">
            <div><dt>{{ _('Gépek', 'Machines') }}</dt><dd>{{ totals.cnc_lathes }} {{ _('CNC eszterga', 'CNC lathes') }}</dd></div>
            <div><dt>{{ _('Gyártók', 'Makes') }}</dt><dd>INDEX, STAR, Nakamura, Takisawa, Mori Seiki</dd></div>
            <div><dt>{{ _('Anyagok', 'Materials') }}</dt><dd>{{ _('Alumínium, sárgaréz, műanyag', 'Aluminium, brass, plastics') }}</dd></div>
          </dl>
          <a class="link-arrow" href="{{ href('services') }}#esztergalas">{{ _('Részletek', 'Details') }}</a>
        </div>
      </div>
      <div class="tabs__panel" role="tabpanel" id="p-mill" aria-labelledby="t-mill" hidden>
        {{ m.photo('cnc-maras.jpg', _('Mart alumínium szelepblokk', 'Milled aluminium manifold'), ratio='4/3', render='manifold:alu') }}
        <div class="tabs__body">
          <h3 class="h3">{{ _('Marási munkák megmunkálóközpontokon', 'Milling on machining centres') }}</h3>
          <p>{{ _('Prizmatikus alkatrészek marása, fúrása, menetkészítése, esztergált alkatrészek utólagos megmunkálása 11 vertikális megmunkálóközponton.', 'Milling, drilling and threading of prismatic parts and secondary machining of turned parts on 11 vertical machining centres.') }}</p>
          <dl class="specs">
            <div><dt>{{ _('Gépek', 'Machines') }}</dt><dd>{{ totals.centres }} {{ _('megmunkálóközpont', 'machining centres') }}</dd></div>
            <div><dt>{{ _('Gyártók', 'Makes') }}</dt><dd>Akira Seiki, Bridgeport, Mori Seiki, OKK</dd></div>
          </dl>
          <a class="link-arrow" href="{{ href('services') }}#maras">{{ _('Részletek', 'Details') }}</a>
        </div>
      </div>
      <div class="tabs__panel" role="tabpanel" id="p-cast" aria-labelledby="t-cast" hidden>
        {{ m.photo('ontveny.jpg', _('Megmunkált alumínium fedél', 'Machined aluminium cover'), ratio='4/3', render='flange:alu') }}
        <div class="tabs__body">
          <h3 class="h3">{{ _('Alumínium- és sárgaréz-öntvények', 'Aluminium and brass castings') }}</h3>
          <p>{{ _('Öntött nyersdarabok kész méretre munkálása: bázisfelületek, illesztések, furatok és menetek sorozatban.', 'Finish machining of raw castings: datum faces, fits, bores and threads in series.') }}</p>
          <a class="link-arrow" href="{{ href('services') }}#ontveny">{{ _('Részletek', 'Details') }}</a>
        </div>
      </div>
      <div class="tabs__panel" role="tabpanel" id="p-gen" aria-labelledby="t-gen" hidden>
        {{ m.photo('altalanos.jpg', _('Hőkezelt, köszörült gépalkatrész', 'Hardened and ground machine part'), ratio='4/3', render='spool:steel') }}
        <div class="tabs__body">
          <h3 class="h3">{{ _('Egyedi, bonyolult geometriájú alkatrészek', 'Custom parts with complex geometry') }}</h3>
          <p>{{ _('Hagyományos gépeken történő fémmegmunkálás; egyedi, kis méretű, de bonyolult geometriájú, hőkezelt, köszörült gépalkatrészek, szerszámok és gépegységek gyártása; mintadarabok és kis sorozatok készítése.', 'Metalworking on conventional machines; custom, small but geometrically complex, heat-treated and ground machine parts, tools and machine assemblies; prototypes and small batches.') }}</p>
          <a class="link-arrow" href="{{ href('services') }}#altalanos">{{ _('Részletek', 'Details') }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Iparágak', 'Industries') }}</p>
        <h2 class="h2">{{ _('Kiemelt iparágaink', 'Key industries') }}</h2>
      </div>
      <p>{{ _('Kis és közepes szériák esetén az ipar szinte minden területére készítettünk már alkatrészeket.', 'In small and medium series we have made components for almost every field of industry.') }}</p>
    </div>
    <ul class="industries industries--light">
      <li class="reveal is-key"><span class="industries__code">{{ _('Kiemelt', 'Key') }}</span><strong>{{ _('Elektronika', 'Electronics') }}</strong><span>{{ _('Elektronikai ipar, elektronikus berendezések', 'Electronics industry and electronic equipment') }}</span></li>
      <li class="reveal is-key"><span class="industries__code">{{ _('Kiemelt', 'Key') }}</span><strong>{{ _('Járműipar', 'Automotive') }}</strong><span>{{ _('Autóipari berendezések alkatrészei', 'Components for automotive equipment') }}</span></li>
      <li class="reveal is-key"><span class="industries__code">{{ _('Kiemelt', 'Key') }}</span><strong>{{ _('Pneumatika, hidraulika', 'Pneumatics, hydraulics') }}</strong><span>{{ _('Munkahengerek, dugattyúk, szelepek', 'Cylinders, pistons, valves') }}</span></li>
      <li class="reveal"><span class="industries__code">04</span><strong>{{ _('Hadiipar', 'Defence') }}</strong><span>{{ _('Precíziós forgácsolt alkatrészek', 'Precision machined components') }}</span></li>
      <li class="reveal"><span class="industries__code">05</span><strong>{{ _('Gépészet', 'Mechanical engineering') }}</strong><span>{{ _('Ipari és mezőgazdasági gépek', 'Industrial and agricultural machinery') }}</span></li>
      <li class="reveal"><span class="industries__code">06</span><strong>{{ _('Repülőgépipar', 'Aerospace') }}</strong><span>{{ _('Többek között a HC-02 helikopter', 'Including the HC-02 helicopter') }}</span></li>
      <li class="reveal"><span class="industries__code">07</span><strong>{{ _('Orvosi és vegyipar', 'Medical & chemical') }}</strong><span>{{ _('Orvosi és vegyipari berendezések', 'Medical and chemical equipment') }}</span></li>
    </ul>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Együttműködés', 'Working with us') }}</p>
        <h2 class="h2">{{ _('Az ajánlatkéréstől a szállításig', 'From enquiry to delivery') }}</h2>
      </div>
    </div>
    {% include "_process.html.j2" %}
  </div>
</section>

<section class="section">
  <div class="wrap feature">
    {{ m.photo('hc02.jpg', _('Hungarocopter HC-02 helikopter', 'Hungarocopter HC-02 helicopter'), ratio='16/10', render='piston:steel') }}
    <div class="feature__text">
      <p class="eyebrow">{{ _('Repülőipar', 'Aerospace') }}</p>
      <h2 class="h2">Hungarocopter HC-02</h2>
      <p>{{ _('Az első magyar fejlesztésű és gyártású kétszemélyes helikopter gyártásában a Hungaro-Copter Kft. partnereként veszünk részt.', 'We manufacture the first Hungarian-designed and built two-seat helicopter as partner of Hungaro-Copter Kft.') }}</p>
      <dl class="specs specs--inline">
        <div><dt>{{ _('Hajtómű', 'Engine') }}</dt><dd>Rotax 915 iS3</dd></div>
        <div><dt>{{ _('Rotor', 'Rotor') }}</dt><dd>Ø 7000 mm</dd></div>
        <div><dt>{{ _('Utazósebesség', 'Cruise') }}</dt><dd>160 km/h</dd></div>
      </dl>
      <a class="link-arrow" href="{{ href('hc02') }}">{{ _('A HC-02 projekt', 'The HC-02 project') }}</a>
    </div>
  </div>
</section>

{% endblock %}
