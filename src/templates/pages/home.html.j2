{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('CNC forgácsolt fém alkatrészek gyártása', 'CNC machined metal components') }}{% endblock %}
{% block content %}

<section class="hero hero--photo" id="hero">
  <div class="hero__bg" aria-hidden="true">
    <img src="{{ asset }}img/csarnok.webp" alt="" fetchpriority="high" width="1774" height="887">
  </div>
  <div class="wrap hero__content">
    <p class="eyebrow eyebrow--light">{{ _('CNC forgácsolt fém alkatrészek gyártása · 1997 óta', 'CNC machined metal components · since 1997') }}</p>
    <h1 class="hero__title">
      <span class="line"><span>{{ _('Precízió,', 'Precision,') }}</span></span>
      <span class="line"><span>{{ _('millió darabban', 'measured in') }}</span></span>
      <span class="line line--muted"><span>{{ _('mérve.', 'millions.') }}</span></span>
    </h1>
    <p class="hero__lead">{{ _('Több mint 20 éve a beszállítói piacon, 70 000 000 eladott termékkel. Közép- és nagysorozatú esztergált és mart alkatrészek az elektronika, a járműipar és a pneumatika számára – az alapanyagtól a kiszállításig.', 'More than 20 years in the supplier market and 70,000,000 parts sold. Medium and large series of turned and milled components for electronics, automotive and pneumatics – from raw material to delivery.') }}</p>
    <div class="hero__actions">
      <a class="btn btn--brass btn--lg" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatkérés', 'Request a quote') }}<span class="btn__arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost-light btn--lg" href="{{ href('services') }}#hogyan-keszul">{{ _('Hogyan készül egy alkatrész?', 'How a part is made') }}</a>
    </div>
  </div>
  <div class="hero__facts">
    <dl class="wrap facts">
      <div><dt>{{ _('Eladott termék', 'Parts sold') }}</dt><dd><span data-count="70">70</span>&nbsp;M+</dd></div>
      <div><dt>{{ _('CNC eszterga', 'CNC lathes') }}</dt><dd><span data-count="{{ totals.cnc_lathes }}">{{ totals.cnc_lathes }}</span></dd></div>
      <div><dt>{{ _('Megmunkálóközpont', 'Machining centres') }}</dt><dd><span data-count="{{ totals.centres }}">{{ totals.centres }}</span></dd></div>
      <div><dt>{{ _('Munkatárs', 'Employees') }}</dt><dd><span data-count="50">50</span></dd></div>
      <div><dt>{{ _('Munkarend', 'Operation') }}</dt><dd>{{ _('3 műszak', '3 shifts') }}</dd></div>
    </dl>
  </div>
  <div class="hero__grant">{% with infoblokk_float = true %}{% include "_infoblokk.html.j2" %}{% endwith %}</div>
</section>

<section class="brands" aria-label="{{ _('Gépparkunk gyártói', 'Machine manufacturers in our plant') }}">
  <div class="wrap brands__inner">
    <p class="brands__label">{{ _('Gépparkunk', 'Our machine park') }}</p>
    <ul class="brands__list">
      <li>INDEX</li><li>STAR</li><li>MORI SEIKI</li><li>NAKAMURA</li><li>TAKISAWA</li><li>AKIRA SEIKI</li><li>BRIDGEPORT</li><li>OKK</li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap intro">
    <div class="intro__text">
      <p class="eyebrow">{{ _('A vállalatról', 'The company') }}</p>
      <p class="statement__text reveal">{{ _('Cégünk vevőcentrikus. Maximálisan törekszünk arra, hogy az általunk elvégzett munka a lehető legjobb minőségben, a megadott határidőn belül és a vevői igényeknek minden téren megfeleljen.', 'We are customer-centric. We strive to ensure that our work is of the highest possible quality, delivered on time and meets customer requirements in every respect.') }}</p>
      <p>{{ _('1997-ben családi vállalkozásként, 3 fővel, egy 200 m²-es verpeléti műhelyben indultunk. Ma 50 munkatárssal, 3 műszakban, 27 000 m²-es saját telephelyen gyártunk – partnereinknek a teljes folyamatot biztosítva az alapanyag beszerzésétől a késztermék kiszállításáig.', 'We started in 1997 as a family business with 3 people in a 200 m² workshop in Verpelét. Today 50 employees produce in 3 shifts on our own 27,000 m² site – covering the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}</p>
      <a class="link-arrow" href="{{ href('about') }}">{{ _('A cég története', 'Our history') }}</a>
    </div>
    <figure class="intro__photo reveal">
      <img src="{{ asset }}img/telephely.webp" alt="{{ _('A Steel Riders Kft. üzemépülete Verpeléten', 'Steel Riders Kft. plant building in Verpelét') }}" loading="lazy" width="1536" height="1024">
      <figcaption>3351 Verpelét, Kossuth út 64.</figcaption>
    </figure>
  </div>
</section>

<section class="section chain-sec" id="ertekLanc">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Egy kézben', 'Single source') }}</p>
        <h2 class="h2">{{ _('Az alapanyagtól a kiszállításig', 'From raw material to delivery') }}</h2>
      </div>
      <p>{{ _('A teljes értékláncot házon belül tartjuk: nincs alvállalkozói lánc, nincs információvesztés – egy kapcsolattartó, egy felelős.', 'We keep the whole value chain in-house: no subcontractor chain, no loss of information – one contact, one responsible partner.') }}</p>
    </div>
    <ol class="chain">
      <li class="chain__item reveal">
        <img src="{{ asset }}img/alapanyag-raktar.webp" alt="{{ _('Alapanyagraktár sárgaréz, alumínium és acél rudakkal', 'Raw material store with brass, aluminium and steel bars') }}" loading="lazy" width="1448" height="1086" style="object-position: 30% 50%">
        <div class="chain__body">
          <span class="chain__n">01</span>
          <h3 class="h3">{{ _('Alapanyag', 'Raw material') }}</h3>
          <p>{{ _('Beszerzés, bizonylatolás és raktározás – a rúdanyag már nálunk van, amikor a gyártás indul.', 'Sourcing, certification and storage – the bar stock is already here when production starts.') }}</p>
          <a href="{{ href('services') }}#anyagok">{{ _('Anyagok', 'Materials') }} →</a>
        </div>
      </li>
      <li class="chain__item reveal">
        <img src="{{ asset }}img/star-sr32.webp" alt="{{ _('STAR hosszeszterga gyártás közben', 'STAR Swiss-type lathe in production') }}" loading="lazy" style="object-position: 42% 50%">
        <div class="chain__body">
          <span class="chain__n">02</span>
          <h3 class="h3">{{ _('Gyártás', 'Machining') }}</h3>
          <p>{{ _(totals.cnc ~ ' CNC és NC gép, 3 műszak – esztergálás Ø 4–630 mm, marás 1350 × 750 mm-ig.', totals.cnc ~ ' CNC and NC machines, 3 shifts – turning Ø 4–630 mm, milling up to 1350 × 750 mm.') }}</p>
          <a href="{{ href('services') }}#parameterek">{{ _('Paraméterek', 'Capabilities') }} →</a>
        </div>
      </li>
      <li class="chain__item reveal">
        <img src="{{ asset }}img/meres-tolomero.webp" alt="{{ _('Esztergált alkatrész mérése a rajz alapján', 'Measuring a turned part against the drawing') }}" loading="lazy" width="1086" height="1448" style="object-position: 50% 40%">
        <div class="chain__body">
          <span class="chain__n">03</span>
          <h3 class="h3">{{ _('Mérés', 'Inspection') }}</h3>
          <p>{{ _('Első darab, gyártásközi és végellenőrzés – klimatizált mérőszobában, 3D mérőgéppel.', 'First-article, in-process and final inspection – in an air-conditioned room with a 3D CMM.') }}</p>
          <a href="{{ href('quality') }}">{{ _('Minőségügy', 'Quality') }} →</a>
        </div>
      </li>
      <li class="chain__item reveal">
        <img src="{{ asset }}img/szallitas.webp" alt="{{ _('Csomagolt alkatrészek kiszállítás előtt', 'Packed parts ready for delivery') }}" loading="lazy" style="object-position: 50% 55%">
        <div class="chain__body">
          <span class="chain__n">04</span>
          <h3 class="h3">{{ _('Kiszállítás', 'Delivery') }}</h3>
          <p>{{ _('Tételazonosított csomagolás és ütemezett szállítás, keretszerződéses hívással is.', 'Lot-labelled packaging and scheduled delivery, including blanket-order call-offs.') }}</p>
          <a href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatkérés', 'Request a quote') }} →</a>
        </div>
      </li>
    </ol>
  </div>
</section>

<section class="section section--dark aerial" id="telephely">
  <div class="wrap aerial__grid">
    <figure class="aerial__hero reveal">
      <img src="{{ asset }}img/telephely-naplemente.webp" alt="{{ _('A Steel Riders Kft. gyártócsarnokai napelemekkel és helikopter-leszállóhellyel, Verpelét', 'Steel Riders Kft. production halls with solar roofs and helipad, Verpelét') }}" loading="lazy" width="1086" height="1448">
      <figcaption><span>Verpelét</span>{{ _('Kossuth út 64. · Heves megye', 'Kossuth út 64. · Heves County') }}</figcaption>
    </figure>
    <div class="aerial__right">
    <div class="aerial__text">
      <p class="eyebrow eyebrow--light">{{ _('Telephely', 'Our site') }}</p>
      <h2 class="h2">{{ _('27 000 m² saját telephely Verpeléten', '27,000 m² own site in Verpelét') }}</h2>
      <p class="lead">{{ _('Két gyártócsarnok, napelemes energiatermelés, saját helikopter-leszállóhely – minden a gyártáshoz és a kiszállításhoz egy helyen, Eger és Gyöngyös között.', 'Two production halls, solar power generation and our own helipad – everything for production and delivery in one place, between Eger and Gyöngyös.') }}</p>
      <dl class="aerial__facts">
        <div><dt>{{ _('Telephely', 'Site') }}</dt><dd>27 000 m²</dd></div>
        <div><dt>{{ _('Gyártócsarnokok', 'Production halls') }}</dt><dd>800 + 1200 m²</dd></div>
        <div><dt>{{ _('Környezet', 'Environment') }}</dt><dd>ISO 14001</dd></div>
        <div><dt>{{ _('Cím', 'Address') }}</dt><dd>Kossuth út 64.</dd></div>
      </dl>
      <a class="link-arrow link-arrow--light" href="{{ href('contact') }}">{{ _('Útvonal és kapcsolat', 'Directions and contact') }}</a>
    </div>
    {% set aspots = [
      (33.5, 19, _('Helikopter-leszállóhely', 'Helipad'), _('Saját helikopter-leszállóhely a telephely északi részén.', 'Our own helipad in the northern part of the site.')),
      (37, 42, _('Gyártócsarnokok', 'Production halls'), _('CNC automata esztergák, megmunkálóközpontok és 3 műszakos sorozatgyártás.', 'CNC automatic lathes, machining centres and 3-shift series production.')),
      (57.5, 86, _('Napelemes energia', 'Solar power'), _('Tetőre szerelt napelemek – ISO 14001 szerinti, felelős működés.', 'Roof-mounted solar panels – responsible operation under ISO 14001.')),
      (56, 70, _('Logisztikai udvar', 'Logistics yard'), _('Alapanyag-beérkezés és késztermék-kiszállítás egy helyen.', 'Raw material intake and finished-goods dispatch in one place.'))
    ] %}
    <figure class="showcase__scene aerial__photo is-active" data-scene="site">
      <img src="{{ asset }}img/telephely-legi.webp" alt="{{ _('A Steel Riders Kft. verpeléti telephelye felülről', 'Aerial view of the Steel Riders Kft. site in Verpelét') }}" loading="lazy" width="1448" height="1086">
      {% for x, y, title, text in aspots %}
      <button type="button" class="spot" style="left: {{ x }}%; top: {{ y }}%" aria-describedby="spot-site-{{ loop.index }}" data-i="{{ loop.index0 }}"><span class="sr-only">{{ title }}</span></button>
      <div class="spot__card{% if y < 35 %} spot__card--below{% endif %}" id="spot-site-{{ loop.index }}" role="tooltip" style="--x: {{ x }}; --y: {{ y }}" data-i="{{ loop.index0 }}">
        <span class="spot__n">{{ '%02d' % loop.index }}</span><strong>{{ title }}</strong><span>{{ text }}</span>
      </div>
      {% endfor %}
      <figcaption class="aerial__cap">47.85° N · 20.23° E</figcaption>
    </figure>
    </div>
  </div>
</section>

<section class="section section--dark showcase-sec" id="alkatreszek">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--light">{{ _('Gyártásunkból', 'From our production') }}</p>
        <h2 class="h2">{{ _('Alkatrészek, amelyek működtetik az ipart', 'Components that keep industry running') }}</h2>
      </div>
      <p>{{ _('Házak, karimás perselyek, tengelyek, szelepalkatrészek – marva és esztergálva, alumíniumból, acélból és sárgarézből. Kattintson a jelölésekre a részletekért.', 'Housings, flanged bushings, shafts, valve components – milled and turned in aluminium, steel and brass. Click the markers for details.') }}</p>
    </div>

    <div class="showcase" data-showcase>
      <div class="showcase__tabs" role="tablist" aria-label="{{ _('Technológia', 'Technology') }}">
        <button role="tab" aria-selected="true" data-scene="mill"><span>01</span>{{ _('Marás · megmunkálóközpont', 'Milling · machining centre') }}</button>
        <button role="tab" aria-selected="false" data-scene="turn"><span>02</span>{{ _('Automata esztergálás · STAR SR 16', 'Automatic turning · STAR SR 16') }}</button>
      </div>

      {% set scenes = [
        ('mill', 'alkatreszek-maras.webp', _('Mart és esztergált alkatrészek a megmunkálóközpont előtt', 'Milled and turned parts in front of the machining centre'), [
          (19, 55, _('Mart alumínium ház', 'Milled aluminium housing'), _('Többoldali megmunkálás: nagy átmérőjű illesztett furat, menetes furatok, zsebek és hornyok egy darabon.', 'Multi-sided machining: large-diameter fitted bore, threaded holes, pockets and slots in one part.')),
          (49, 45, _('Karimás persely', 'Flanged bushing'), _('Esztergált test és karima, osztókörön elhelyezett furatokkal – esztergálás és marás kombinációja.', 'Turned body and flange with holes on a pitch circle – a combination of turning and milling.')),
          (79, 51, _('Keretes alkatrész', 'Frame component'), _('Zsebmarás, belső kontúrok és átmenő furatok alumíniumból, vertikális megmunkálóközponton.', 'Pocket milling, internal contours and through holes in aluminium on a vertical machining centre.')),
          (19, 80, _('Fogaskerék', 'Spur gear'), _('Esztergált agy és fogazott kerület – egyedi és kis sorozatú hajtáselemek.', 'Turned hub and toothed rim – one-off and small-batch drive components.')),
          (78, 73, _('Kar, hajtókar', 'Lever arm'), _('Kontúrmarás, furatok és süllyesztések egy felfogásban.', 'Contour milling, holes and counterbores in one set-up.')),
          (26, 16, _('Vertikális megmunkálóközpont', 'Vertical machining centre'), _('11 vertikális megmunkálóközpont: Akira Seiki, Bridgeport, Mori Seiki, OKK – Fanuc, Heidenhain és Mitsubishi vezérléssel.', '11 vertical machining centres: Akira Seiki, Bridgeport, Mori Seiki, OKK – with Fanuc, Heidenhain and Mitsubishi controls.'))
        ]),
        ('turn', 'star-sr16.webp', _('STAR SR 16 automata eszterga esztergált alkatrészekkel', 'STAR SR 16 automatic lathe with turned parts'), [
          (78, 40, _('STAR SR 16 automata eszterga', 'STAR SR 16 automatic lathe'), _('15 CNC automata eszterga (INDEX, STAR) közép- és nagysorozatú alkatrészgyártáshoz, rúdanyagból.', '15 CNC automatic lathes (INDEX, STAR) for medium and large series production from bar stock.')),
          (32, 16, _('Fanuc vezérlés', 'Fanuc control'), _('A STAR esztergák Fanuc 16T, 18i és 0i-TF vezérléssel dolgoznak.', 'The STAR lathes run on Fanuc 16T, 18i and 0i-TF controls.')),
          (31, 76, _('Sárgaréz alkatrészek', 'Brass components'), _('Menetes, furatos sárgaréz alkatrészek – kiemelten elektronikai és pneumatikai felhasználásra.', 'Threaded and bored brass components – especially for electronics and pneumatics.')),
          (39, 81, _('Recézett alkatrész', 'Knurled part'), _('Recézés, keresztfuratok és menetek egyetlen gépen, egy felfogásban.', 'Knurling, cross holes and threads on a single machine, in one set-up.')),
          (48, 91, _('Tengelyek', 'Shafts'), _('Hosszú, karcsú tengelyek hosszesztergálással, szűk tűréssel.', 'Long, slender shafts by Swiss-type turning with tight tolerances.')),
          (65, 76, _('Keresztfuratos alkatrészek', 'Cross-drilled parts'), _('Hajtott szerszámokkal fúrt keresztfuratok és mart felületek esztergált alkatrészeken.', 'Cross holes drilled and faces milled with driven tools on turned parts.'))
        ])
      ] %}
      {% for key, file, alt, spots in scenes %}
      <figure class="showcase__scene{% if loop.first %} is-active{% endif %}" data-scene="{{ key }}"{% if not loop.first %} hidden{% endif %}>
        <img src="{{ asset }}img/{{ file }}" alt="{{ alt }}" loading="lazy" width="1448" height="1086">
        {% for x, y, title, text in spots %}
        <button type="button" class="spot" style="left: {{ x }}%; top: {{ y }}%" aria-describedby="spot-{{ key }}-{{ loop.index }}" data-i="{{ loop.index0 }}">
          <span class="sr-only">{{ title }}</span>
        </button>
        <div class="spot__card{% if y < 35 %} spot__card--below{% endif %}" id="spot-{{ key }}-{{ loop.index }}" role="tooltip" style="--x: {{ x }}; --y: {{ y }}" data-i="{{ loop.index0 }}">
          <span class="spot__n">{{ '%02d' % loop.index }}</span>
          <strong>{{ title }}</strong>
          <span>{{ text }}</span>
        </div>
        {% endfor %}
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Miért a Steel Riders?', 'Why Steel Riders?') }}</p>
        <h2 class="h2">{{ _('Beszállító, akire a sorozatot is rá lehet bízni', 'A supplier you can trust with the whole series') }}</h2>
      </div>
      <p>{{ _('Több mint 20 év a beszállítói piacon, 70 000 000 eladott termék – a rajztól a kiszállított alkatrészig.', 'More than 20 years in the supplier market and 70,000,000 parts sold – from drawing to delivered component.') }}</p>
    </div>
    <div class="why">
      <article class="why__item reveal">
        <span class="why__n">{{ totals.all }}</span>
        <h3 class="h3">{{ _('Gép egy telephelyen', 'Machines on one site') }}</h3>
        <p>{{ _('CNC automata és ellenorsós esztergák, vertikális megmunkálóközpontok, NC és hagyományos gépek, köszörűk – a teljes technológiai lánc házon belül.', 'CNC automatic and sub-spindle lathes, vertical machining centres, NC and conventional machines, grinders – the whole process chain in-house.') }}</p>
      </article>
      <article class="why__item reveal">
        <span class="why__n">3×8</span>
        <h3 class="h3">{{ _('Három műszak', 'Three shifts') }}</h3>
        <p>{{ _('Folyamatos, tervezhető kapacitás közép- és nagysorozatokhoz, ütemezett szállításokkal.', 'Continuous, plannable capacity for medium and large series with scheduled deliveries.') }}</p>
      </article>
      <article class="why__item reveal">
        <span class="why__n">ISO</span>
        <h3 class="h3">{{ _('Tanúsított minőség', 'Certified quality') }}</h3>
        <p>{{ _('ISO 9001 és ISO 14001 szerinti működés, saját mérőszoba, SAP alapú nyomon követés.', 'ISO 9001 and ISO 14001 systems, in-house measuring room, SAP-based traceability.') }}</p>
      </article>
      <article class="why__item reveal">
        <span class="why__n">1:1</span>
        <h3 class="h3">{{ _('Minden egy kézben', 'Single source') }}</h3>
        <p>{{ _('Alapanyag-beszerzéstől a kiszállításig – kevesebb logisztikai költség, egy felelős partner.', 'From material sourcing to delivery – lower logistics costs and one accountable partner.') }}</p>
      </article>
    </div>
  </div>
</section>

<section class="ship">
  <div class="ship__media">
    <img src="{{ asset }}img/szallitas.webp" alt="{{ _('Ellenőrzött, tálcákba rendezett esztergált alkatrészek Steel Riders dobozokkal szállítás előtt', 'Inspected turned parts arranged in trays with Steel Riders boxes before shipment') }}" loading="lazy" width="1448" height="1086">
  </div>
  <div class="wrap ship__inner">
    <div class="ship__card reveal">
      <p class="eyebrow">{{ _('Szállítás', 'Delivery') }}</p>
      <h2 class="h2">{{ _('Ellenőrizve, csomagolva, szállításra készen', 'Inspected, packed, ready to ship') }}</h2>
      <p>{{ _('Minden sorozat végellenőrzésen megy át, mielőtt elhagyja az üzemet. Az alkatrészeket a partner igényei szerint, sérülésmentesen csomagoljuk – tálcákba, tasakokba vagy egyedi csomagolásba.', 'Every batch passes final inspection before it leaves the plant. Parts are packed to customer requirements and protected from damage – in trays, bags or custom packaging.') }}</p>
      <ul class="checks">
        <li>{{ _('Végellenőrzés és dokumentált mérési eredmények', 'Final inspection with documented results') }}</li>
        <li>{{ _('Csomagolás a partner előírásai szerint', 'Packaging to customer specification') }}</li>
        <li>{{ _('SAP alapú tételkövetés', 'SAP-based lot traceability') }}</li>
        <li>{{ _('Ütemezett, megbízható kiszállítás', 'Scheduled, reliable deliveries') }}</li>
      </ul>
      <a class="btn btn--brass" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatot kérek', 'Request a quote') }}<span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Tevékenység', 'Activities') }}</p>
        <h2 class="h2">{{ _('CNC megmunkálás és általános fémforgácsolás', 'CNC machining and general metal cutting') }}</h2>
      </div>
      <p>{{ _('Termelésünk gerincét ' ~ totals.cnc_lathes ~ ' CNC eszterga és ' ~ totals.centres ~ ' megmunkálóközpont adja, NC csúcsesztergákkal és hagyományos gépekkel kiegészülve.', 'Our production is built on ' ~ totals.cnc_lathes ~ ' CNC lathes and ' ~ totals.centres ~ ' machining centres, complemented by NC centre lathes and conventional machines.') }}</p>
    </div>

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="{{ _('Technológiák', 'Technologies') }}">
        <button role="tab" id="t-turn" aria-controls="p-turn" aria-selected="true"><span>01</span>{{ _('CNC esztergálás', 'CNC turning') }}</button>
