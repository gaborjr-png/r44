{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Minőségügy', 'Quality') }}{% endblock %}
{% block content %}

{{ m.page_head(_('Minőségügy', 'Quality'),
   _('Minőségbiztosítás és környezettudatos működés', 'Quality assurance and environmental responsibility'),
   _('A hazai és nemzetközi piac növekvő elvárásainak való megfelelés érdekében kiemelt figyelmet fordítunk a minőségbiztosításra.', 'To meet the growing requirements of domestic and international markets, we place particular emphasis on quality assurance.'),
   'cmm.webp', 'bushing:brass', pos='55% 50%') }}

<section class="section">
  <div class="wrap">
    <div class="q-cards">
      <article class="q-card">
        <p class="q-card__std">ISO 9001</p>
        <h2 class="h3">{{ _('Minőségirányítási rendszer', 'Quality management system') }}</h2>
        <p>{{ _('Dokumentált folyamatok az ajánlatadástól a szállításig: szerződés-átvizsgálás, gyártástervezés, ellenőrzés, nem megfelelő termékek kezelése és folyamatos fejlesztés.', 'Documented processes from quotation to delivery: contract review, production planning, inspection, control of non-conforming product and continuous improvement.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">ISO 14001</p>
        <h2 class="h3">{{ _('Környezetirányítási rendszer', 'Environmental management system') }}</h2>
        <p>{{ _('A forgácsolási hulladék, a hűtő-kenő folyadékok és az energiafelhasználás szabályozott, felelős kezelése.', 'Controlled, responsible handling of swarf, coolants and energy consumption.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">QA</p>
        <h2 class="h3">{{ _('Saját mérőszoba', 'In-house measuring room') }}</h2>
        <p>{{ _('Az első minták, a gyártásközi és a végellenőrzés mérései saját mérőszobánkban készülnek, kérésre mérési jegyzőkönyvvel.', 'First-sample, in-process and final inspection measurements are carried out in our own measuring room, with inspection reports on request.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">SAP</p>
        <h2 class="h3">{{ _('Integrált vállalatirányítás', 'Integrated ERP') }}</h2>
        <p>{{ _('SAP integrált vállalatirányítási rendszer és gyártásirányítás a rendelések, készletek és gyártási tételek nyomon követéséhez.', 'SAP integrated ERP and production management to track orders, stock and production lots.') }}</p>
      </article>
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--light">{{ _('Mérőszoba', 'Metrology') }}</p>
        <h2 class="h2">{{ _('Mérőeszközeink', 'Our measuring equipment') }}</h2>
      </div>
      <p>{{ _('Klimatizált, a gyártócsarnoktól elválasztott mérőszobában ellenőrizzük az első darabokat, a gyártásközi mintákat és a kiszállítás előtti tételeket – állandó hőmérsékleten, hogy a mérési eredmények megbízhatóak legyenek.', 'First articles, in-process samples and lots before shipment are checked in an air-conditioned measuring room separated from the production hall – at a constant temperature for reliable results.') }}</p>
    </div>
    <div class="instruments">
      <figure class="instrument reveal">
        <div class="instrument__img"><img src="{{ asset }}img/cmm.webp" alt="{{ _('3D koordináta-mérőgép mérés közben', '3D coordinate measuring machine measuring a part') }}" loading="lazy" width="1448" height="1086"></div>
        <figcaption>
          <span class="instrument__tag">CMM</span>
          <strong>{{ _('3D koordináta-mérőgép', '3D coordinate measuring machine') }}</strong>
          <span>{{ _('Tapintós mérés gránit mérőasztalon: furattávolságok, pozíció- és alaktűrések, összetett mart és esztergált alkatrészek teljes geometriája.', 'Touch-probe measurement on a granite table: hole spacing, position and form tolerances, full geometry of complex milled and turned parts.') }}</span>
        </figcaption>
      </figure>
      <figure class="instrument reveal">
        <div class="instrument__img"><img src="{{ asset }}img/meroszoba.webp" alt="{{ _('Optikai mérőrendszer automatikus méréssel', 'Optical measuring system with automatic measurement') }}" loading="lazy" width="1448" height="1086" style="object-position: 62% 45%"></div>
        <figcaption>
          <span class="instrument__tag">{{ _('Optikai', 'Optical') }}</span>
          <strong>{{ _('Optikai mérőrendszer', 'Optical measuring system') }}</strong>
          <span>{{ _('Esztergált alkatrészek érintésmentes, automatikus mérése másodpercek alatt – átmérők, hosszak, menetek, OK/NOK kiértékeléssel.', 'Non-contact, automatic measurement of turned parts in seconds – diameters, lengths, threads, with OK/NOK evaluation.') }}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap split">
    {{ m.photo('szallitas.webp', _('Végellenőrzött alkatrészek tálcákban', 'Inspected parts in trays'), '', '4/3', pos='40% 55%', zoom=1.15) }}
    <div>
      <p class="eyebrow">{{ _('Ellenőrzés', 'Inspection') }}</p>
      <h2 class="h2">{{ _('Ellenőrzés a teljes folyamatban', 'Inspection throughout the process') }}</h2>
      <ol class="steps">
        <li><strong>{{ _('Beérkező anyag', 'Incoming material') }}</strong><span>{{ _('Anyagminőség és tanúsítványok ellenőrzése.', 'Verification of material grade and certificates.') }}</span></li>
        <li><strong>{{ _('Első darab', 'First article') }}</strong><span>{{ _('Beállítás utáni első darab mérése a gyártás indítása előtt.', 'Measurement of the first part after set-up, before production is released.') }}</span></li>
        <li><strong>{{ _('Gyártásközi ellenőrzés', 'In-process inspection') }}</strong><span>{{ _('Rendszeres mintavétel és mérés a sorozat alatt.', 'Regular sampling and measurement during the run.') }}</span></li>
        <li><strong>{{ _('Végellenőrzés', 'Final inspection') }}</strong><span>{{ _('Kiszállítás előtti ellenőrzés és dokumentálás.', 'Inspection and documentation before shipment.') }}</span></li>
      </ol>
    </div>
  </div>
</section>

{% endblock %}
