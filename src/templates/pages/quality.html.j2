{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Minőségügy', 'Quality') }}{% endblock %}
{% block content %}

{{ m.page_head(_('Minőségügy', 'Quality'),
   _('Minőségbiztosítás és környezettudatos működés', 'Quality assurance and environmental responsibility'),
   _('A hazai és nemzetközi piac növekvő elvárásainak való megfelelés érdekében kiemelt figyelmet fordítunk a minőségbiztosításra.', 'To meet the growing requirements of domestic and international markets, we place particular emphasis on quality assurance.'),
   'cmm.webp', 'bushing:brass', pos='55% 50%') }}

<section class="section">
  <div class="wrap">
    <div class="q-cards">
      <article class="q-card">
        <p class="q-card__std">ISO 9001</p>
        <h2 class="h3">{{ _('Minőségirányítási rendszer', 'Quality management system') }}</h2>
        <p>{{ _('Dokumentált folyamatok az ajánlatadástól a szállításig: szerződés-átvizsgálás, gyártástervezés, ellenőrzés, nem megfelelő termékek kezelése és folyamatos fejlesztés.', 'Documented processes from quotation to delivery: contract review, production planning, inspection, control of non-conforming product and continuous improvement.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">ISO 14001</p>
        <h2 class="h3">{{ _('Környezetirányítási rendszer', 'Environmental management system') }}</h2>
        <p>{{ _('A forgácsolási hulladék, a hűtő-kenő folyadékok és az energiafelhasználás szabályozott, felelős kezelése – 48,96 kWp napelemes rendszerrel és napkollektorral.', 'Controlled, responsible handling of swarf, coolants and energy consumption – with a 48.96 kWp solar PV system and solar thermal collectors.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">QA</p>
        <h2 class="h3">{{ _('Saját mérőszoba', 'In-house measuring room') }}</h2>
        <p>{{ _('Az első minták, a gyártásközi és a végellenőrzés mérései saját mérőszobánkban készülnek, kérésre mérési jegyzőkönyvvel.', 'First-sample, in-process and final inspection measurements are carried out in our own measuring room, with inspection reports on request.') }}</p>
      </article>
      <article class="q-card">
        <p class="q-card__std">SAP</p>
        <h2 class="h3">{{ _('Integrált vállalatirányítás', 'Integrated ERP') }}</h2>
        <p>{{ _('SAP integrált vállalatirányítási rendszer és gyártásirányítás a rendelések, készletek és gyártási tételek nyomon követéséhez.', 'SAP integrated ERP and production management to track orders, stock and production lots.') }}</p>
      </article>
    </div>
  </div>
</section>

<section class="section section--tint" id="tanusitvanyok">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Tanúsítványok', 'Certificates') }}</p>
        <h2 class="h2">{{ _('Tanúsított irányítási rendszerek', 'Certified management systems') }}</h2>
      </div>
      <p class="section-head__lead">{{ _('Minőség- és környezetirányítási rendszerünket a NAH által akkreditált International Cert Hungary Kft. tanúsítja. A tanúsítványok magyar és német nyelven, PDF-ben letölthetők beszállítói auditokhoz és minősítésekhez.', 'Our quality and environmental management systems are certified by International Cert Hungary Kft., accredited by the Hungarian Accreditation Board (NAH). The certificates can be downloaded as PDF in Hungarian and German for supplier audits and approvals.') }}</p>
    </div>
    <div class="certs2">
      {% for c in site.certs %}
      <article class="certx reveal" id="{{ c.slug }}">
        <button class="certx__doc" type="button" data-lightbox="{{ asset }}img/cert-{{ c.slug }}-{{ lang if lang == 'hu' else 'de' }}.webp" data-caption="{{ c.std }} – {{ _(c.title[0], c.title[1]) }}" aria-label="{{ _('Tanúsítvány megtekintése', 'View certificate') }}: {{ c.std }}">
          <img src="{{ asset }}img/cert-{{ c.slug }}-{{ 'hu' if lang == 'hu' else 'de' }}-thumb.webp" alt="{{ c.std }} {{ _('tanúsítvány – Steel Riders Kft., International Cert Hungary Kft.', 'certificate – Steel Riders Kft., International Cert Hungary Kft.') }}" loading="lazy" width="560" height="806">
          <span class="certx__zoom" aria-hidden="true">⤢ {{ _('Nagyítás', 'Enlarge') }}</span>
        </button>
        <div class="certx__info">
          <div class="certx__top">
            <span class="certx__seal" aria-hidden="true"><b>ISO</b>{{ c.num }}</span>
            {% if c.valid >= today %}<span class="certx__status"><i></i>{{ _('Érvényes', 'Valid') }}</span>{% endif %}
          </div>
          <p class="certx__std">{{ c.std }}</p>
          <h3 class="h3">{{ _(c.title[0], c.title[1]) }}</h3>
          <dl class="certx__dl">
            <div><dt>{{ _('Érvényességi terület', 'Scope') }}</dt><dd>{{ _(c.scope[0], c.scope[1]) }}</dd></div>
            <div><dt>{{ _('Tanúsító szervezet', 'Certification body') }}</dt><dd>{{ c.body }}<small>{{ _('NAH által akkreditált', 'NAH accredited') }} · {{ c.acc }}</small></dd></div>
            <div><dt>{{ _('Regisztrációs szám', 'Registration no.') }}</dt><dd class="mono">{{ c.no }}</dd></div>
            {% if c.audit is defined %}<div><dt>{{ _('Rendszeraudit', 'System audit') }}</dt><dd>{{ _(c.audit[0], c.audit[1]) }}</dd></div>{% endif %}
            <div><dt>{{ _('Kiállítva', 'Issued') }}</dt><dd>{{ _(c.issued[0], c.issued[1]) }}</dd></div>
            <div><dt>{{ _('Érvényes', 'Valid until') }}</dt><dd><b>{{ _(c.valid_txt[0], c.valid_txt[1]) }}</b></dd></div>
          </dl>
          <div class="certx__actions">
            <a class="btn btn--dark btn--sm" href="{{ asset }}docs/{{ c.slug }}-hu.pdf" download>PDF · {{ _('magyar', 'Hungarian') }}</a>
            <a class="btn btn--outline btn--sm" href="{{ asset }}docs/{{ c.slug }}-de.pdf" download>PDF · {{ _('német', 'German') }}</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    <a class="cert-ask reveal" href="mailto:info1@steelriderskft.hu?subject={{ _('Minőségügyi dokumentum kérése', 'Quality document request') | urlencode }}">
      <span class="cert-ask__icon" aria-hidden="true">QA</span>
      <span><b>{{ _('Beszállítói dokumentáció kérésre', 'Supplier documentation on request') }}</b> {{ _('Első minta jelentés (FAI / PPAP), anyagbizonylat 3.1, RoHS- és REACH-nyilatkozat, beszállítói kérdőív.', 'First article report (FAI / PPAP), 3.1 material certificate, RoHS and REACH declarations, supplier questionnaire.') }}</span>
      <span class="cert-ask__go">{{ _('Kérés e-mailben', 'Request by e-mail') }} →</span>
    </a>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--light">{{ _('Mérőszoba', 'Metrology') }}</p>
        <h2 class="h2">{{ _('Mérőeszközeink', 'Our measuring equipment') }}</h2>
      </div>
      <p>{{ _('Klimatizált, a gyártócsarnoktól elválasztott mérőszobában ellenőrizzük az első darabokat, a gyártásközi mintákat és a kiszállítás előtti tételeket – állandó hőmérsékleten, hogy a mérési eredmények megbízhatóak legyenek.', 'First articles, in-process samples and lots before shipment are checked in an air-conditioned measuring room separated from the production hall – at a constant temperature for reliable results.') }}</p>
    </div>
    <div class="instruments">
      <figure class="instrument reveal">
        <div class="instrument__img"><img src="{{ asset }}img/cmm.webp" alt="{{ _('3D koordináta-mérőgép mérés közben', '3D coordinate measuring machine measuring a part') }}" loading="lazy" width="1448" height="1086"></div>
        <figcaption>
          <span class="instrument__tag">CMM</span>
          <strong>{{ _('MICRO-3D CNC koordináta-mérőgép', 'MICRO-3D CNC coordinate measuring machine') }}</strong>
          <span>{{ _('Tapintós mérés gránit mérőasztalon: furattávolságok, pozíció- és alaktűrések, összetett mart és esztergált alkatrészek teljes geometriája.', 'Touch-probe measurement on a granite table: hole spacing, position and form tolerances, full geometry of complex milled and turned parts.') }}</span>
        </figcaption>
      </figure>
      <figure class="instrument reveal">
        <div class="instrument__img"><img src="{{ asset }}img/meroszoba.webp" alt="{{ _('Optikai mérőrendszer automatikus méréssel', 'Optical measuring system with automatic measurement') }}" loading="lazy" width="1448" height="1086" style="object-position: 62% 45%"></div>
        <figcaption>
          <span class="instrument__tag">{{ _('Optikai', 'Optical') }}</span>
          <strong>{{ _('Képalkotásos profilmérő', 'Imaging profile measuring system') }}</strong>
          <span>{{ _('Esztergált alkatrészek érintésmentes, automatikus mérése másodpercek alatt – átmérők, hosszak, menetek, OK/NOK kiértékeléssel. Profilokhoz és rádiuszokhoz kontúrmérővel egészül ki.', 'Non-contact, automatic measurement of turned parts in seconds – diameters, lengths, threads, with OK/NOK evaluation. Complemented by a contour measuring instrument for profiles and radii.') }}</span>
        </figcaption>
      </figure>
      <figure class="instrument reveal">
        <div class="instrument__img"><img src="{{ asset }}img/mikrometer.webp" alt="{{ _('Digitális mikrométer mérőállványon a gépsor mellett', 'Digital micrometer on a stand next to the machines') }}" loading="lazy" width="1086" height="1448" style="object-position: 50% 45%"></div>
        <figcaption>
          <span class="instrument__tag">{{ _('Gépközeli', 'At the machine') }}</span>
          <strong>{{ _('Digitális mikrométerek', 'Digital micrometers') }}</strong>
          <span>{{ _('A gépek mellett, mérőállványon: a kezelők 0,001 mm felbontással ellenőrzik a kritikus átmérőket a sorozat közben, kalibrált mérőeszközökkel.', 'Next to the machines, on stands: operators check critical diameters during the run with 0.001 mm resolution, using calibrated instruments.') }}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap split inspect">
    {{ m.photo('meres-tolomero.webp', _('Esztergált rozsdamentes csatlakozó mérése digitális tolómérővel a műszaki rajz mellett, menetgyűrűvel és határidomszerekkel', 'Measuring a turned stainless fitting with a digital caliper next to the drawing, with thread ring and plug gauges'), 'inspect__photo', '4/5', pos='50% 50%', caption=_('Első darab ellenőrzése a rajz alapján', 'First-article check against the drawing')) }}
    <div>
      <p class="eyebrow">{{ _('Ellenőrzés', 'Inspection') }}</p>
      <h2 class="h2">{{ _('Ellenőrzés a teljes folyamatban', 'Inspection throughout the process') }}</h2>
      <ol class="steps">
        <li><strong>{{ _('Beérkező anyag', 'Incoming material') }}</strong><span>{{ _('Anyagminőség és tanúsítványok ellenőrzése.', 'Verification of material grade and certificates.') }}</span></li>
        <li><strong>{{ _('Első darab', 'First article') }}</strong><span>{{ _('Beállítás utáni első darab mérése a gyártás indítása előtt.', 'Measurement of the first part after set-up, before production is released.') }}</span></li>
        <li><strong>{{ _('Gyártásközi ellenőrzés', 'In-process inspection') }}</strong><span>{{ _('Rendszeres mintavétel és mérés a sorozat alatt.', 'Regular sampling and measurement during the run.') }}</span></li>
        <li><strong>{{ _('Végellenőrzés', 'Final inspection') }}</strong><span>{{ _('Kiszállítás előtti ellenőrzés és dokumentálás.', 'Inspection and documentation before shipment.') }}</span></li>
      </ol>
      <ul class="inspect__tools">
        <li>{{ _('Digitális tolómérők', 'Digital calipers') }}</li><li>{{ _('Menetgyűrűk, menetdugók', 'Thread ring & plug gauges') }}</li><li>{{ _('Határidomszerek', 'Limit gauges') }}</li><li>{{ _('Mikrométerek', 'Micrometers') }}</li><li>CMM</li><li>{{ _('Optikai mérés', 'Optical measurement') }}</li>
      </ul>
    </div>
  </div>
</section>

{% endblock %}
