    <div class="legal__body prose">
      <h2 class="h3" id="adatkezelo">1. {{ _('Az adatkezelő', 'The controller') }}</h2>
      <dl class="datasheet imprint__sheet">
        <div><dt>{{ _('Név', 'Name') }}</dt><dd>Steel Riders Kft.</dd></div>
        <div><dt>{{ _('Székhely', 'Registered office') }}</dt><dd>3351 Verpelét, Kossuth út 64.</dd></div>
        <div><dt>{{ _('Cégjegyzékszám', 'Company reg. no.') }}</dt><dd>10-09-022629</dd></div>
        <div><dt>{{ _('Képviselő', 'Represented by') }}</dt><dd>{{ _('Farkas Gábor ügyvezető', 'Gábor Farkas, managing director') }}</dd></div>
        <div><dt>{{ _('Adatvédelmi kapcsolattartás', 'Data protection contact') }}</dt><dd><a href="mailto:info1@steelriderskft.hu">info1@steelriderskft.hu</a>, +36 36 494 183</dd></div>
      </dl>
      <p>{{ _('Cégünk nem köteles adatvédelmi tisztviselőt kijelölni. Adatvédelmi kérdésekben a fenti elérhetőségeken fordulhat hozzánk.', 'We are not required to appoint a data protection officer. You can contact us about data protection at the details above.') }}</p>

