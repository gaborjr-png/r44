      <table>
        <thead><tr><th>{{ _('Cél', 'Purpose') }}</th><th>{{ _('Kezelt adatok', 'Data') }}</th><th>{{ _('Jogalap', 'Legal basis') }}</th><th>{{ _('Időtartam', 'Retention') }}</th></tr></thead>
        <tbody>
          <tr><td>{{ _('Ajánlatkérés, kapcsolatfelvétel', 'Quotation requests, enquiries') }}</td><td>{{ _('név, cégnév, e-mail, telefon, üzenet, csatolt műszaki dokumentumok', 'name, company, e-mail, phone, message, attached technical documents') }}</td><td>{{ _('GDPR 6. cikk (1) b) – szerződéskötést megelőző lépések; f) – jogos érdek', 'Art. 6(1)(b) GDPR – pre-contractual steps; (f) – legitimate interest') }}</td><td>{{ _('az ajánlattól számított 2 év; szerződés esetén a számviteli megőrzési idő (8 év)', '2 years from the quotation; if a contract follows, the statutory accounting retention period (8 years)') }}</td></tr>
          <tr><td>{{ _('Álláspályázat', 'Job applications') }}</td><td>{{ _('név, elérhetőség, önéletrajz, végzettség, tapasztalat', 'name, contact details, CV, qualifications, experience') }}</td><td>{{ _('GDPR 6. cikk (1) a) – hozzájárulás', 'Art. 6(1)(a) GDPR – consent') }}</td><td>{{ _('a pozíció betöltéséig, hozzájárulással legfeljebb 1 évig', 'until the position is filled, with consent for up to 1 year') }}</td></tr>
          <tr><td>{{ _('Üzleti kapcsolattartás', 'Business relations') }}</td><td>{{ _('partnereink kapcsolattartóinak neve, beosztása, elérhetősége', 'names, positions and contact details of our partners’ contacts') }}</td><td>{{ _('GDPR 6. cikk (1) f) – jogos érdek', 'Art. 6(1)(f) GDPR – legitimate interest') }}</td><td>{{ _('az üzleti kapcsolat fennállásáig', 'for the duration of the business relationship') }}</td></tr>
          <tr><td>{{ _('Látogatottsági statisztika', 'Visitor statistics') }}</td><td>{{ _('anonimizált IP-cím, böngésző, megtekintett oldalak', 'anonymised IP address, browser, pages viewed') }}</td><td>{{ _('GDPR 6. cikk (1) a) – hozzájárulás (süti-sáv)', 'Art. 6(1)(a) GDPR – consent (cookie banner)') }}</td><td>{{ _('14 hónap', '14 months') }}</td></tr>
          <tr><td>{{ _('Szerver naplófájlok', 'Server log files') }}</td><td>{{ _('IP-cím, időpont, lekért oldal', 'IP address, time, requested page') }}</td><td>{{ _('GDPR 6. cikk (1) f) – a weboldal biztonsága', 'Art. 6(1)(f) GDPR – website security') }}</td><td>{{ _('30 nap', '30 days') }}</td></tr>
        </tbody>
      </table>
