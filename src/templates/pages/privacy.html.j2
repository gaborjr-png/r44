        <li><a href="#sutik">{{ _('Sütik', 'Cookies') }}</a></li>
        <li><a href="#biztonsag">{{ _('Adatbiztonság', 'Data security') }}</a></li>
        <li><a href="#jogok">{{ _('Az Ön jogai', 'Your rights') }}</a></li>
