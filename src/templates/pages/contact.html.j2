<section class="section section--tint" id="ajanlatkeres">
  <div class="wrap contact-grid">
    <form class="rfq" id="rfq" novalidate data-to="{{ site.rfq_email }}" data-endpoint="{{ root }}api/ajanlatkeres.php" data-lang="{{ lang }}"
          data-msg-invalid="{{ _('Kérjük, töltse ki a *-gal jelölt mezőket.', 'Please complete the fields marked *.') }}"
          data-msg-subject="{{ _('Ajánlatkérés', 'Request for quotation') }}"
          data-msg-type="{{ _('Nem támogatott fájltípus', 'Unsupported file type') }}"
          data-msg-size="{{ _('Legfeljebb 5 fájl, összesen 20 MB csatolható.', 'Up to 5 files, 20 MB in total.') }}"
          data-msg-sending="{{ _('Küldés…', 'Sending…') }}"
          data-msg-remove="{{ _('Eltávolítás', 'Remove') }}"
          data-msg-files="{{ _('Csatolmányok', 'Attachments') }}">
      <h2 class="h2">{{ _('Ajánlatkérés', 'Request for quotation') }}</h2>
      <p>{{ _('Adja meg az alkatrész főbb adatait, és csatolja a műszaki rajzot (PDF) vagy a 3D modellt (STEP). Munkatársunk ' ~ site.response_hours ~ ' órán belül felveszi Önnel a kapcsolatot.', 'Enter the main details of the part and attach the drawing (PDF) or 3D model (STEP). A colleague will get back to you within ' ~ site.response_hours ~ ' hours.') }}</p>
      <p class="rfq__sla"><span class="rfq__sla-dot" aria-hidden="true"></span>{{ _('Válaszidő: ' ~ site.response_hours ~ ' órán belül, munkanapokon', 'Response time: within ' ~ site.response_hours ~ ' hours on working days') }}</p>

      <ol class="stepper" aria-hidden="true">
        <li class="is-active"><span>1</span>{{ _('Kapcsolattartó', 'Contact') }}</li>
        <li><span>2</span>{{ _('Alkatrész', 'Part') }}</li>
        <li><span>3</span>{{ _('Összesítés', 'Review') }}</li>
      </ol>

      <fieldset class="rfq__step" data-step="1">
        <legend>{{ _('1. lépés – Kapcsolattartó', 'Step 1 – Contact person') }}</legend>
        <div class="field-row">
          <div class="field"><label for="f-name">{{ _('Név', 'Name') }} *</label><input id="f-name" name="name" required autocomplete="name"></div>
          <div class="field"><label for="f-company">{{ _('Cég', 'Company') }} *</label><input id="f-company" name="company" required autocomplete="organization"></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-email">{{ _('E-mail', 'E-mail') }} *</label><input id="f-email" name="email" type="email" required autocomplete="email"></div>
          <div class="field"><label for="f-phone">{{ _('Telefon', 'Phone') }}</label><input id="f-phone" name="phone" type="tel" autocomplete="tel"></div>
        </div>
        <div class="rfq__nav"><span></span><button class="btn btn--dark" type="button" data-next>{{ _('Tovább', 'Next') }} <span class="btn__arrow" aria-hidden="true">→</span></button></div>
      </fieldset>

      <fieldset class="rfq__step" data-step="2">
        <legend>{{ _('2. lépés – Alkatrész', 'Step 2 – Part') }}</legend>
        <div class="field-row">
          <div class="field"><label for="f-part">{{ _('Megnevezés / rajzszám', 'Part name / drawing no.') }}</label><input id="f-part" name="part"></div>
          <div class="field"><label for="f-material">{{ _('Anyag', 'Material') }}</label>
            <select id="f-material" name="material">
              <option value="">{{ _('Válasszon', 'Select') }}</option>
              <option>{{ _('Alumínium', 'Aluminium') }}</option>
              <option>{{ _('Sárgaréz', 'Brass') }}</option>
              <option>{{ _('Műszaki műanyag', 'Engineering plastic') }}</option>
              <option>{{ _('Alumíniumöntvény', 'Aluminium casting') }}</option>
              <option>{{ _('Sárgaréz-öntvény', 'Brass casting') }}</option>
              <option>{{ _('Egyéb', 'Other') }}</option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-tech">{{ _('Technológia', 'Technology') }}</label>
            <select id="f-tech" name="tech">
              <option value="">{{ _('Válasszon', 'Select') }}</option>
              <option>{{ _('Esztergálás', 'Turning') }}</option>
              <option>{{ _('Marás', 'Milling') }}</option>
              <option>{{ _('Esztergálás + marás', 'Turning + milling') }}</option>
              <option>{{ _('Öntvény-megmunkálás', 'Casting machining') }}</option>
            </select>
          </div>
          <div class="field"><label for="f-qty">{{ _('Éves mennyiség (db)', 'Annual quantity (pcs)') }}</label><input id="f-qty" name="qty" inputmode="numeric"></div>
        </div>
        <div class="field"><label for="f-msg">{{ _('Megjegyzés', 'Notes') }} *</label><textarea id="f-msg" name="message" rows="5" required placeholder="{{ _('Pl. tűrések, felületkezelés, szállítási ütemezés', 'e.g. tolerances, surface treatment, delivery schedule') }}"></textarea></div>
        <div class="field">
          <label for="f-files">{{ _('Műszaki rajz, 3D modell', 'Drawing, 3D model') }}</label>
          <div class="drop" id="rfqDrop">
            <input id="f-files" type="file" multiple accept=".pdf,.step,.stp,.igs,.iges,.dxf,.dwg,.x_t,.sldprt,.zip,.png,.jpg,.jpeg" aria-describedby="f-files-hint">
            <svg class="drop__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-4.5 4.5M12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p><b>{{ _('Húzza ide a fájlokat', 'Drop files here') }}</b> {{ _('vagy kattintson a tallózáshoz', 'or click to browse') }}</p>
            <small id="f-files-hint">PDF · STEP · IGES · DXF · DWG · ZIP — {{ _('max. 5 fájl, összesen 20 MB', 'max. 5 files, 20 MB in total') }}</small>
          </div>
          <ul class="drop__list" id="rfqList"></ul>
        </div>
        <label class="check"><input type="checkbox" name="consent" id="f-consent" required> <span>{{ _('Elolvastam és elfogadom az', 'I have read and accept the') }} <a href="{{ href('privacy') }}" target="_blank">{{ _('adatkezelési tájékoztatót', 'privacy notice') }}</a>. *</span></label>
        <div class="hp" aria-hidden="true"><label for="f-website">Website</label><input id="f-website" name="website" tabindex="-1" autocomplete="off"></div>
        <div class="rfq__nav"><button class="btn btn--outline" type="button" data-prev>← {{ _('Vissza', 'Back') }}</button><button class="btn btn--brass" type="submit">{{ _('Összesítés', 'Review') }} <span class="btn__arrow" aria-hidden="true">→</span></button></div>
      </fieldset>

      <p class="rfq__status" id="rfqStatus" role="status" aria-live="polite"></p>

      <div class="rfq__result rfq__step" data-step="3" id="rfqResult" hidden>
        <p><strong>{{ _('Kérjük, ellenőrizze az adatokat.', 'Please review your request.') }}</strong> {{ _('A küldés után visszaigazoló e-mailt kap.', 'You will receive a confirmation e-mail after sending.') }}</p>
        <pre class="rfq__text" id="rfqText"></pre>
        <div class="rfq__buttons" id="rfqActions">
          <button class="btn btn--brass" type="button" id="rfqSend">{{ _('Ajánlatkérés elküldése', 'Send request') }} <span class="btn__arrow" aria-hidden="true">→</span></button>
          <button class="btn btn--text" type="button" data-prev>← {{ _('Módosítás', 'Edit') }}</button>
        </div>
        <div class="rfq__fallback" id="rfqFallback" hidden>
          <p>{{ _('Az online küldés most nem érhető el. Küldje el e-mailben a', 'Online sending is not available right now. Please e-mail it to') }} <span class="mono">{{ site.rfq_email }}</span> {{ _('címre, a rajzokat csatolva.', 'with your drawings attached.') }}</p>
          <div class="rfq__buttons">
            <a class="btn btn--brass" id="rfqMail" href="mailto:{{ site.rfq_email }}">{{ _('Megnyitás levelezőben', 'Open in e-mail client') }}</a>
            <button class="btn btn--outline" type="button" id="rfqCopy" data-done="{{ _('Kimásolva', 'Copied') }}">{{ _('Szöveg másolása', 'Copy text') }}</button>
          </div>
        </div>
      </div>

      <div class="rfq__done" id="rfqDone" hidden tabindex="-1">
        <span class="rfq__tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <h3 class="h3">{{ _('Köszönjük, megkaptuk ajánlatkérését!', 'Thank you, we have received your request!') }}</h3>
        <p>{{ _('Azonosító:', 'Reference:') }} <b class="mono" id="rfqRef"></b></p>
        <p>{{ _('Munkatársunk ' ~ site.response_hours ~ ' órán belül felveszi Önnel a kapcsolatot. Visszaigazolást küldtünk a megadott e-mail-címre.', 'A colleague will contact you within ' ~ site.response_hours ~ ' hours. We have sent a confirmation to your e-mail address.') }}</p>
      </div>
    </form>

    <aside class="visit">
      <img class="visit__photo" src="{{ asset }}img/telephely.webp" alt="{{ _('A Steel Riders Kft. üzemépülete', 'Steel Riders Kft. plant building') }}" loading="lazy" width="1536" height="1024">
      <h2 class="h3">{{ _('Telephely', 'Location') }}</h2>
      <address>
        Steel Riders Kft.<br>
        3351 Verpelét, Kossuth út 64.<br>
        {{ _('Magyarország', 'Hungary') }}
      </address>
      <p class="visit__note">{{ _('Verpelét Heves megyében, Eger és Gyöngyös között található.', 'Verpelét is in Heves County, between Eger and Gyöngyös.') }}</p>
      <div class="mapbox" id="mapbox" data-src="{{ site.maps_embed }}">
        <button class="mapbox__load" type="button" id="mapLoad">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <b>{{ _('Térkép megjelenítése', 'Show map') }}</b>
          <small>{{ _('A Google Térkép betöltésével a Google sütiket helyezhet el.', 'Loading Google Maps lets Google set cookies.') }}</small>
        </button>
      </div>
      <a class="btn btn--outline btn--block" href="{{ site.maps_url }}" target="_blank" rel="noopener">{{ _('Útvonaltervezés', 'Get directions') }}</a>
      <dl class="visit__data">
        <div><dt>{{ _('Cégnév', 'Company') }}</dt><dd>Steel Riders Kft.</dd></div>
        <div><dt>{{ _('Adószám', 'VAT no.') }}</dt><dd>11174864-2-10</dd></div>
        <div><dt>{{ _('Cégjegyzékszám', 'Reg. no.') }}</dt><dd>10-09-022629</dd></div>
      </dl>
      <a class="review" href="{{ site.review_url }}" target="_blank" rel="noopener">
        <span class="review__stars" aria-hidden="true">★★★★★</span>
        <span><b>{{ _('Dolgozott már velünk?', 'Worked with us?') }}</b> {{ _('Értékeljen minket a Google-ön', 'Rate us on Google') }} →</span>
      </a>
    </aside>
  </div>
</section>


<section class="section" id="gyik">
  <div class="wrap faq">
    <div>
      <p class="eyebrow">{{ _('Gyakori kérdések', 'FAQ') }}</p>
      <h2 class="h2">{{ _('Mielőtt ajánlatot kér', 'Before you request a quote') }}</h2>
      <p class="faq__lead">{{ _('Nem találja a választ? Hívjon minket:', 'Can’t find the answer? Call us:') }} <a href="tel:+3636494183">+36 36 494 183</a></p>
    </div>
    <div class="faq__list">
      <details class="faq__item">
        <summary>{{ _('Mennyi idő alatt kapok ajánlatot?', 'How quickly will I receive a quote?') }}</summary>
        <p>{{ _('' ~ site.response_hours ~ ' órán belül visszajelzünk, és egyeztetjük a nyitott műszaki kérdéseket. Egyszerűbb alkatrészekre jellemzően 3–5 munkanapon belül, összetett, több műveletes alkatrészekre 5–10 munkanapon belül adunk ajánlatot.', 'We get back to you within ' ~ site.response_hours ~ ' hours to clarify any open technical questions. For simpler parts we typically quote within 3–5 working days, for complex multi-operation parts within 5–10 working days.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen formátumban küldjem a műszaki rajzot?', 'In which format should I send the drawing?') }}</summary>
        <p>{{ _('Legjobb a méretezett műszaki rajz PDF-ben és a 3D modell STEP formátumban. DXF rajzot is fogadunk. Kérjük, adja meg az anyagminőséget, a felületkezelést és a várható éves mennyiséget is.', 'Ideally a dimensioned drawing as PDF and the 3D model as STEP. We also accept DXF. Please include the material grade, surface treatment and expected annual quantity.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen anyagokat munkálnak meg?', 'Which materials do you machine?') }}</summary>
        <p>{{ _('Kiemelten alumínium, sárgaréz és műszaki műanyag alkatrészeket gyártunk, emellett acél alkatrészeket, valamint alumínium- és sárgaréz-öntvényeket is megmunkálunk.', 'Mainly aluminium, brass and engineering plastic parts, as well as steel components and aluminium and brass castings.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Az alapanyagot önök szerzik be?', 'Do you source the raw material?') }}</summary>
        <p>{{ _('Igen. Partnereink számára a teljes folyamatot biztosítjuk az alapanyag beszerzésétől a késztermék kiszállításáig.', 'Yes. We cover the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen sorozatnagyságot vállalnak?', 'What batch sizes do you take on?') }}</summary>
        <p>{{ _('Mintadarabokat és kis sorozatokat is készítünk, fő profilunk azonban a közép- és nagysorozatú gyártás 3 műszakban.', 'We make prototypes and small batches, but our main focus is medium and large series production in 3 shifts.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Kaphatok mérési jegyzőkönyvet?', 'Can I get an inspection report?') }}</summary>
        <p>{{ _('Igen, kérésre. Az első darabokat és a sorozatmintákat klimatizált mérőszobánkban, 3D koordináta-mérőgéppel és optikai mérőrendszerrel ellenőrizzük.', 'Yes, on request. First articles and series samples are checked in our air-conditioned measuring room with a 3D coordinate measuring machine and an optical measuring system.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen minőségirányítási rendszer szerint dolgoznak?', 'Which management systems do you work to?') }}</summary>
        <p>{{ _('ISO 9001 minőségirányítási és ISO 14001 környezetirányítási rendszer szerint, SAP alapú nyomon követéssel.', 'ISO 9001 quality management and ISO 14001 environmental management, with SAP-based traceability.') }}</p>
      </details>
    </div>
  </div>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"{{ _('Mennyi idő alatt kapok ajánlatot?', 'How quickly will I receive a quote?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('' ~ site.response_hours ~ ' órán belül visszajelzünk, és egyeztetjük a nyitott műszaki kérdéseket. Egyszerűbb alkatrészekre jellemzően 3–5 munkanapon belül, összetett, több műveletes alkatrészekre 5–10 munkanapon belül adunk ajánlatot.', 'We get back to you within ' ~ site.response_hours ~ ' hours to clarify any open technical questions. For simpler parts we typically quote within 3–5 working days, for complex multi-operation parts within 5–10 working days.') }}"}},{"@type":"Question","name":"{{ _('Milyen formátumban küldjem a műszaki rajzot?', 'In which format should I send the drawing?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Legjobb a méretezett műszaki rajz PDF-ben és a 3D modell STEP formátumban. DXF rajzot is fogadunk. Kérjük, adja meg az anyagminőséget, a felületkezelést és a várható éves mennyiséget is.', 'Ideally a dimensioned drawing as PDF and the 3D model as STEP. We also accept DXF. Please include the material grade, surface treatment and expected annual quantity.') }}"}},{"@type":"Question","name":"{{ _('Milyen anyagokat munkálnak meg?', 'Which materials do you machine?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Kiemelten alumínium, sárgaréz és műszaki műanyag alkatrészeket gyártunk, emellett acél alkatrészeket, valamint alumínium- és sárgaréz-öntvényeket is megmunkálunk.', 'Mainly aluminium, brass and engineering plastic parts, as well as steel components and aluminium and brass castings.') }}"}},{"@type":"Question","name":"{{ _('Az alapanyagot önök szerzik be?', 'Do you source the raw material?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Igen. Partnereink számára a teljes folyamatot biztosítjuk az alapanyag beszerzésétől a késztermék kiszállításáig.', 'Yes. We cover the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}"}},{"@type":"Question","name":"{{ _('Milyen sorozatnagyságot vállalnak?', 'What batch sizes do you take on?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Mintadarabokat és kis sorozatokat is készítünk, fő profilunk azonban a közép- és nagysorozatú gyártás 3 műszakban.', 'We make prototypes and small batches, but our main focus is medium and large series production in 3 shifts.') }}"}},{"@type":"Question","name":"{{ _('Kaphatok mérési jegyzőkönyvet?', 'Can I get an inspection report?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Igen, kérésre. Az első darabokat és a sorozatmintákat klimatizált mérőszobánkban, 3D koordináta-mérőgéppel és optikai mérőrendszerrel ellenőrizzük.', 'Yes, on request. First articles and series samples are checked in our air-conditioned measuring room with a 3D coordinate measuring machine and an optical measuring system.') }}"}},{"@type":"Question","name":"{{ _('Milyen minőségirányítási rendszer szerint dolgoznak?', 'Which management systems do you work to?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('ISO 9001 minőségirányítási és ISO 14001 környezetirányítási rendszer szerint, SAP alapú nyomon követéssel.', 'ISO 9001 quality management and ISO 14001 environmental management, with SAP-based traceability.') }}"}}]}</script>
</section>

