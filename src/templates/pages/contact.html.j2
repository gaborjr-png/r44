{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Kapcsolat', 'Contact') }}{% endblock %}
{% block content %}

{{ m.page_head(_('Kapcsolat', 'Contact'),
   _('Vegye fel velünk a kapcsolatot', 'Get in touch'),
   _('Ajánlatkéréssel, gyártási kérdéssel vagy álláspályázattal keressen minket bizalommal.', 'Contact us with an enquiry, a manufacturing question or a job application.')) }}

<section class="section">
  <div class="wrap">
    <div class="people">
      <article class="person reveal">
        <p class="person__role">{{ _('Ügyvezető', 'Managing Director') }}</p>
        <h2 class="person__name">Farkas Gábor</h2>
        <p class="person__lines"><a href="tel:+36303828398">+36 30 382 8398</a><a href="mailto:info1@steelriderskft.hu">info1@steelriderskft.hu</a></p>
      </article>
      <article class="person reveal">
        <p class="person__role">{{ _('Üzemvezető', 'Plant Manager') }}</p>
        <h2 class="person__name">Kiszály Tamás</h2>
        <p class="person__lines"><a href="tel:+36304518637">+36 30 451 8637</a><a href="mailto:kiszaly.tamas@steelriderskft.hu">kiszaly.tamas@steelriderskft.hu</a></p>
      </article>
      <article class="person reveal">
        <p class="person__role">{{ _('Munkaügy', 'Human Resources') }}</p>
        <h2 class="person__name">Pfundt Krisztina</h2>
        <p class="person__lines"><a href="tel:+36306812644">+36 30 681 2644</a><a href="mailto:munkaugy@steelriderskft.hu">munkaugy@steelriderskft.hu</a></p>
      </article>
      <article class="person reveal">
        <p class="person__role">{{ _('Központ', 'Main office') }}</p>
        <h2 class="person__name">Steel Riders Kft.</h2>
        <p class="person__lines"><a href="tel:+3636494183">+36 36 494 183</a><a href="mailto:info@steelriderskft.hu">info@steelriderskft.hu</a></p>
      </article>
    </div>
  </div>
</section>

<section class="section section--tint" id="ajanlatkeres">
  <div class="wrap contact-grid">
    <form class="rfq" id="rfq" novalidate data-to="info1@steelriderskft.hu"
          data-msg-invalid="{{ _('Kérjük, töltse ki a *-gal jelölt mezőket.', 'Please complete the fields marked *.') }}"
          data-msg-subject="{{ _('Ajánlatkérés', 'Request for quotation') }}">
      <h2 class="h2">{{ _('Ajánlatkérés', 'Request for quotation') }}</h2>
      <p>{{ _('Adja meg az alkatrész főbb adatait. A műszaki rajzot (PDF) és a 3D modellt (STEP) a megnyíló e-mailhez csatolhatja.', 'Enter the main details of the part. You can attach the drawing (PDF) and 3D model (STEP) to the e-mail that opens.') }}</p>

      <ol class="stepper" aria-hidden="true">
        <li class="is-active"><span>1</span>{{ _('Kapcsolattartó', 'Contact') }}</li>
        <li><span>2</span>{{ _('Alkatrész', 'Part') }}</li>
        <li><span>3</span>{{ _('Összesítés', 'Review') }}</li>
      </ol>

      <fieldset class="rfq__step" data-step="1">
        <legend>{{ _('1. lépés – Kapcsolattartó', 'Step 1 – Contact person') }}</legend>
        <div class="field-row">
          <div class="field"><label for="f-name">{{ _('Név', 'Name') }} *</label><input id="f-name" name="name" required autocomplete="name"></div>
          <div class="field"><label for="f-company">{{ _('Cég', 'Company') }} *</label><input id="f-company" name="company" required autocomplete="organization"></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-email">{{ _('E-mail', 'E-mail') }} *</label><input id="f-email" name="email" type="email" required autocomplete="email"></div>
          <div class="field"><label for="f-phone">{{ _('Telefon', 'Phone') }}</label><input id="f-phone" name="phone" type="tel" autocomplete="tel"></div>
        </div>
        <div class="rfq__nav"><span></span><button class="btn btn--dark" type="button" data-next>{{ _('Tovább', 'Next') }} <span class="btn__arrow" aria-hidden="true">→</span></button></div>
      </fieldset>

      <fieldset class="rfq__step" data-step="2">
        <legend>{{ _('2. lépés – Alkatrész', 'Step 2 – Part') }}</legend>
        <div class="field-row">
          <div class="field"><label for="f-part">{{ _('Megnevezés / rajzszám', 'Part name / drawing no.') }}</label><input id="f-part" name="part"></div>
          <div class="field"><label for="f-material">{{ _('Anyag', 'Material') }}</label>
            <select id="f-material" name="material">
              <option value="">{{ _('Válasszon', 'Select') }}</option>
              <option>{{ _('Alumínium', 'Aluminium') }}</option>
              <option>{{ _('Sárgaréz', 'Brass') }}</option>
              <option>{{ _('Műszaki műanyag', 'Engineering plastic') }}</option>
              <option>{{ _('Alumíniumöntvény', 'Aluminium casting') }}</option>
              <option>{{ _('Sárgaréz-öntvény', 'Brass casting') }}</option>
              <option>{{ _('Egyéb', 'Other') }}</option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-tech">{{ _('Technológia', 'Technology') }}</label>
            <select id="f-tech" name="tech">
              <option value="">{{ _('Válasszon', 'Select') }}</option>
              <option>{{ _('Esztergálás', 'Turning') }}</option>
              <option>{{ _('Marás', 'Milling') }}</option>
              <option>{{ _('Esztergálás + marás', 'Turning + milling') }}</option>
              <option>{{ _('Öntvény-megmunkálás', 'Casting machining') }}</option>
            </select>
          </div>
          <div class="field"><label for="f-qty">{{ _('Éves mennyiség (db)', 'Annual quantity (pcs)') }}</label><input id="f-qty" name="qty" inputmode="numeric"></div>
        </div>
        <div class="field"><label for="f-msg">{{ _('Megjegyzés', 'Notes') }} *</label><textarea id="f-msg" name="message" rows="5" required placeholder="{{ _('Pl. tűrések, felületkezelés, szállítási ütemezés', 'e.g. tolerances, surface treatment, delivery schedule') }}"></textarea></div>
        <div class="rfq__nav"><button class="btn btn--outline" type="button" data-prev>← {{ _('Vissza', 'Back') }}</button><button class="btn btn--brass" type="submit">{{ _('Összesítés', 'Review') }} <span class="btn__arrow" aria-hidden="true">→</span></button></div>
      </fieldset>

      <p class="rfq__status" id="rfqStatus" role="status" aria-live="polite"></p>

      <div class="rfq__result rfq__step" data-step="3" id="rfqResult" hidden>
        <p><strong>{{ _('Az ajánlatkérés elkészült.', 'Your request is ready.') }}</strong> {{ _('Küldje el e-mailben a', 'Send it by e-mail to') }} <span class="mono">info1@steelriderskft.hu</span> {{ _('címre, a rajzokat csatolva.', 'with your drawings attached.') }}</p>
        <pre class="rfq__text" id="rfqText"></pre>
        <div class="rfq__buttons">
          <a class="btn btn--brass" id="rfqMail" href="mailto:info1@steelriderskft.hu">{{ _('Megnyitás levelezőben', 'Open in e-mail client') }}</a>
          <button class="btn btn--outline" type="button" id="rfqCopy" data-done="{{ _('Kimásolva', 'Copied') }}">{{ _('Szöveg másolása', 'Copy text') }}</button>
          <button class="btn btn--text" type="button" data-prev>← {{ _('Módosítás', 'Edit') }}</button>
        </div>
      </div>
    </form>

    <aside class="visit">
      <img class="visit__photo" src="{{ asset }}img/telephely.webp" alt="{{ _('A Steel Riders Kft. üzemépülete', 'Steel Riders Kft. plant building') }}" loading="lazy" width="1536" height="1024">
      <h2 class="h3">{{ _('Telephely', 'Location') }}</h2>
      <address>
        Steel Riders Kft.<br>
        3351 Verpelét, Kossuth út 64.<br>
        {{ _('Magyarország', 'Hungary') }}
      </address>
      <p class="visit__note">{{ _('Verpelét Heves megyében, Eger és Gyöngyös között található.', 'Verpelét is in Heves County, between Eger and Gyöngyös.') }}</p>
      <a class="btn btn--outline btn--block" href="https://www.google.com/maps/search/?api=1&amp;query=Steel+Riders+Kft+Verpel%C3%A9t+Kossuth+%C3%BAt+64" target="_blank" rel="noopener">{{ _('Útvonaltervezés', 'Get directions') }}</a>
      <dl class="visit__data">
        <div><dt>{{ _('Cégnév', 'Company') }}</dt><dd>Steel Riders Kft.</dd></div>
        <div><dt>{{ _('Adószám', 'VAT no.') }}</dt><dd>11174864-2-10</dd></div>
        <div><dt>{{ _('Cégjegyzékszám', 'Reg. no.') }}</dt><dd>10-09-022629</dd></div>
      </dl>
    </aside>
  </div>
</section>


<section class="section" id="gyik">
  <div class="wrap faq">
    <div>
      <p class="eyebrow">{{ _('Gyakori kérdések', 'FAQ') }}</p>
      <h2 class="h2">{{ _('Mielőtt ajánlatot kér', 'Before you request a quote') }}</h2>
      <p class="faq__lead">{{ _('Nem találja a választ? Hívjon minket:', 'Can’t find the answer? Call us:') }} <a href="tel:+3636494183">+36 36 494 183</a></p>
    </div>
    <div class="faq__list">
      <details class="faq__item">
        <summary>{{ _('Milyen formátumban küldjem a műszaki rajzot?', 'In which format should I send the drawing?') }}</summary>
        <p>{{ _('Legjobb a méretezett műszaki rajz PDF-ben és a 3D modell STEP formátumban. DXF rajzot is fogadunk. Kérjük, adja meg az anyagminőséget, a felületkezelést és a várható éves mennyiséget is.', 'Ideally a dimensioned drawing as PDF and the 3D model as STEP. We also accept DXF. Please include the material grade, surface treatment and expected annual quantity.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen anyagokat munkálnak meg?', 'Which materials do you machine?') }}</summary>
        <p>{{ _('Kiemelten alumínium, sárgaréz és műszaki műanyag alkatrészeket gyártunk, emellett acél alkatrészeket, valamint alumínium- és sárgaréz-öntvényeket is megmunkálunk.', 'Mainly aluminium, brass and engineering plastic parts, as well as steel components and aluminium and brass castings.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Az alapanyagot önök szerzik be?', 'Do you source the raw material?') }}</summary>
        <p>{{ _('Igen. Partnereink számára a teljes folyamatot biztosítjuk az alapanyag beszerzésétől a késztermék kiszállításáig.', 'Yes. We cover the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen sorozatnagyságot vállalnak?', 'What batch sizes do you take on?') }}</summary>
        <p>{{ _('Mintadarabokat és kis sorozatokat is készítünk, fő profilunk azonban a közép- és nagysorozatú gyártás 3 műszakban.', 'We make prototypes and small batches, but our main focus is medium and large series production in 3 shifts.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Kaphatok mérési jegyzőkönyvet?', 'Can I get an inspection report?') }}</summary>
        <p>{{ _('Igen, kérésre. Az első darabokat és a sorozatmintákat klimatizált mérőszobánkban, 3D koordináta-mérőgéppel és optikai mérőrendszerrel ellenőrizzük.', 'Yes, on request. First articles and series samples are checked in our air-conditioned measuring room with a 3D coordinate measuring machine and an optical measuring system.') }}</p>
      </details>
      <details class="faq__item">
        <summary>{{ _('Milyen minőségirányítási rendszer szerint dolgoznak?', 'Which management systems do you work to?') }}</summary>
        <p>{{ _('ISO 9001 minőségirányítási és ISO 14001 környezetirányítási rendszer szerint, SAP alapú nyomon követéssel.', 'ISO 9001 quality management and ISO 14001 environmental management, with SAP-based traceability.') }}</p>
      </details>
    </div>
  </div>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"{{ _('Milyen formátumban küldjem a műszaki rajzot?', 'In which format should I send the drawing?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Legjobb a méretezett műszaki rajz PDF-ben és a 3D modell STEP formátumban. DXF rajzot is fogadunk. Kérjük, adja meg az anyagminőséget, a felületkezelést és a várható éves mennyiséget is.', 'Ideally a dimensioned drawing as PDF and the 3D model as STEP. We also accept DXF. Please include the material grade, surface treatment and expected annual quantity.') }}"}},{"@type":"Question","name":"{{ _('Milyen anyagokat munkálnak meg?', 'Which materials do you machine?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Kiemelten alumínium, sárgaréz és műszaki műanyag alkatrészeket gyártunk, emellett acél alkatrészeket, valamint alumínium- és sárgaréz-öntvényeket is megmunkálunk.', 'Mainly aluminium, brass and engineering plastic parts, as well as steel components and aluminium and brass castings.') }}"}},{"@type":"Question","name":"{{ _('Az alapanyagot önök szerzik be?', 'Do you source the raw material?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Igen. Partnereink számára a teljes folyamatot biztosítjuk az alapanyag beszerzésétől a késztermék kiszállításáig.', 'Yes. We cover the whole process for our partners, from raw material sourcing to delivery of the finished product.') }}"}},{"@type":"Question","name":"{{ _('Milyen sorozatnagyságot vállalnak?', 'What batch sizes do you take on?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Mintadarabokat és kis sorozatokat is készítünk, fő profilunk azonban a közép- és nagysorozatú gyártás 3 műszakban.', 'We make prototypes and small batches, but our main focus is medium and large series production in 3 shifts.') }}"}},{"@type":"Question","name":"{{ _('Kaphatok mérési jegyzőkönyvet?', 'Can I get an inspection report?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('Igen, kérésre. Az első darabokat és a sorozatmintákat klimatizált mérőszobánkban, 3D koordináta-mérőgéppel és optikai mérőrendszerrel ellenőrizzük.', 'Yes, on request. First articles and series samples are checked in our air-conditioned measuring room with a 3D coordinate measuring machine and an optical measuring system.') }}"}},{"@type":"Question","name":"{{ _('Milyen minőségirányítási rendszer szerint dolgoznak?', 'Which management systems do you work to?') }}","acceptedAnswer":{"@type":"Answer","text":"{{ _('ISO 9001 minőségirányítási és ISO 14001 környezetirányítási rendszer szerint, SAP alapú nyomon követéssel.', 'ISO 9001 quality management and ISO 14001 environmental management, with SAP-based traceability.') }}"}}]}</script>
</section>

{% endblock %}
