          <rect x="6" y="14" width="40" height="82" rx="3" class="cap__chuck"/>
          <path d="M46 20h8v-6h6v82h-6v-6h-8z" class="cap__jaw"/>
          <rect x="60" y="14" width="70" height="82" rx="2" class="cap__stock"/>
          <path d="M140 8 l10 -2 v10z" class="cap__tool"/>
          <path d="M150 14v82M146 14h8M146 96h8" class="cap__dim"/>
          <text x="160" y="60" class="cap__lbl">Ø 630</text>
        </svg>
        <p class="cap__kind">{{ _('Tokmányos CNC esztergálás', 'CNC chucker turning') }}</p>
