<section class="section" id="parameterek">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Technológiai paraméterek', 'Technical capabilities') }}</p>
        <h2 class="h2">{{ _('Mit tudunk legyártani?', 'What can we make?') }}</h2>
      </div>
      <p class="section-head__lead">{{ _('A jellemző megmunkálási tartományok gépparkunk alapján. A határértékek közelében lévő alkatrészeknél kérje egyedi ajánlatunkat.', 'Typical machining envelopes based on our machine park. For parts close to the limits, ask for an individual quotation.') }}</p>
    </div>
    <div class="caps">
      <article class="cap reveal">
        <svg class="cap__fig" viewBox="0 0 240 110" aria-hidden="true">
          <rect x="6" y="42" width="36" height="26" rx="2" class="cap__chuck"/>
          <rect x="42" y="47" width="150" height="16" class="cap__stock"/>
          <path d="M192 47h10v16h-10" class="cap__stock cap__stock--part"/>
          <path d="M150 38 l8 -12 h14 l-8 12z" class="cap__tool"/>
          <path d="M214 47v16M210 47h8M210 63h8" class="cap__dim"/>
          <text x="222" y="58" class="cap__lbl">Ø</text>
          <path d="M42 84h160M42 80v8M202 80v8" class="cap__dim"/>
          <text x="122" y="100" class="cap__lbl" text-anchor="middle">L ≤ 320</text>
        </svg>
        <p class="cap__kind">{{ _('Hosszesztergálás rúdból', 'Swiss-type bar turning') }}</p>
