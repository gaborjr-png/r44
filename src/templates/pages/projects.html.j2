{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Projektek', 'Projects') }}{% endblock %}
{% block content %}

{{ m.page_head(_('Projektek', 'Projects'),
   _('Beruházások és pályázati projektek', 'Investments and funded projects'),
   _('2012 óta ' ~ grants|length ~ ' uniós és hazai támogatással megvalósult fejlesztés: új CNC gépek, mérőeszközök, gyártócsarnok, SAP, napelemes rendszer és saját helikopterfejlesztés.', 'Since 2012, ' ~ grants|length ~ ' developments completed with EU and national funding: new CNC machines, measuring equipment, a production hall, SAP, solar power and our own helicopter development.'),
   'telephely.webp', 'bushing:brass', stats=[(_('támogatott projekt', 'funded projects'), grants|length), (_('óta', 'since'), 2012), (_('új CNC gép', 'new CNC machines'), 6), (_('napelem', 'solar PV'), '48,96 kWp' if lang == 'hu' else '48.96 kWp')], pos='50% 55%') }}

<nav class="subnav subnav--years" aria-label="{{ _('Projektek évek szerint', 'Projects by year') }}">
  <div class="wrap subnav__inner">
    {% for g in grants %}<a href="#{{ g.id }}"><b>{{ g.year }}</b> {{ _(g.tag[0], g.tag[1]) }}</a>{% endfor %}
  </div>
</nav>

<section class="section">
  <div class="wrap">
    <div class="projects">
      {% for g in grants %}
      <article class="project reveal" id="{{ g.id }}">
        <div class="project__meta">
          <span class="project__year">{{ g.year }}</span>
          <span class="project__tag">{{ _(g.tag[0], g.tag[1]) }}</span>
        </div>
        <div class="project__body">
          <h2 class="h3">{{ _(g.title[0], g.title[1]) }}</h2>
          {% if g.full is defined %}<p class="project__full">{{ _(g.full[0], g.full[1]) }}</p>{% endif %}
          <p class="project__lead">{{ _(g.lead[0], g.lead[1]) }}</p>
          <dl class="project__facts">
            {% for k, v in g.facts %}<div><dt>{{ _(k[0], k[1]) }}</dt><dd{% if v[0].startswith('GINOP') %} class="mono"{% endif %}>{{ _(v[0], v[1]) }}</dd></div>{% endfor %}
          </dl>
          <p class="project__sub">{{ _('A projekt tartalma', 'Project scope') }}</p>
          <ul class="project__items">
            {% for it in g['items'] %}<li>{{ _(it[0], it[1]) }}</li>{% endfor %}
          </ul>
          <details class="project__more">
            <summary>{{ _('A projekt részletes bemutatása', 'Full project description') }}</summary>
            <div class="project__text">
              {% for para in g.body %}<p>{{ _(para[0], para[1]) }}</p>{% endfor %}
              {% if g.extra is defined %}
              <dl class="specs">
                {% for k, v in g.extra %}<div><dt>{{ _(k[0], k[1]) }}</dt><dd>{{ _(v[0], v[1]) }}</dd></div>{% endfor %}
              </dl>
              {% endif %}
            </div>
          </details>
          {% if g.link is defined %}<a class="link-arrow" href="{{ href(g.link) }}">{{ _('A HC-02 helikopter projekt', 'The HC-02 helicopter project') }}</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tint" id="szechenyi">
  <div class="wrap grant">
    <div>
      <p class="eyebrow">Széchenyi 2020</p>
      <h2 class="h2">{{ _('Európai uniós támogatással megvalósult fejlesztések', 'Developments co-funded by the European Union') }}</h2>
      <p class="lead">{{ _('GINOP-projektjeink a Széchenyi 2020 program keretében, az Európai Unió támogatásával, az Európai Regionális Fejlesztési Alap társfinanszírozásával valósultak meg. 2012-es és 2013-as fejlesztéseink – köztük a csarnokátalakítás az Észak-magyarországi Operatív Program keretében – szintén uniós támogatással valósultak meg.', 'Our GINOP projects were implemented under the Széchenyi 2020 programme with the support of the European Union, co-financed by the European Regional Development Fund. Our 2012 and 2013 developments – including the hall conversion under the North Hungary Operational Programme – were also EU-funded.') }}</p>
      <dl class="specs">
        <div><dt>{{ _('Kedvezményezett', 'Beneficiary') }}</dt><dd>Steel Riders Kft.</dd></div>
        <div><dt>{{ _('Operatív program', 'Operational programme') }}</dt><dd>{{ _('Gazdaságfejlesztési és Innovációs Operatív Program (GINOP)', 'Economic Development and Innovation Operational Programme (GINOP)') }}</dd></div>
        <div><dt>{{ _('További információ', 'More information') }}</dt><dd><a href="https://www.palyazat.gov.hu" target="_blank" rel="noopener">palyazat.gov.hu</a></dd></div>
      </dl>
    </div>
    {% include "_infoblokk.html.j2" %}
  </div>
</section>

{% endblock %}
