{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ _('Rólunk', 'About us') }}{% endblock %}
{% block content %}

{{ m.page_head(_('Rólunk', 'About us'),
   _(years ~ ' év a fémforgácsolásban', years ~ ' years in metal cutting'),
   _('A Steel Riders Kft. 1997 márciusában alakult családi vállalkozásként Verpeléten. Fő tevékenységünk a fémforgácsolás: egyedi munkadarabok gyártása és sorozatgyártás.', 'Steel Riders Kft. was founded in March 1997 as a family business in Verpelét, Hungary. Our core activity is metal cutting: one-off workpieces and series production.'),
   'telephely-legi.webp', 'series:brass', pos='50% 45%') }}

<section class="section">
  <div class="wrap split split--wide">
    <div class="prose">
      <h2 class="h2">{{ _('A vállalat', 'The company') }}</h2>
      <p class="lead">{{ _('Kezdetben 3 fővel, egy 200 m²-es műhelyben dolgoztunk. Mára stabil, 50 főt foglalkoztató vállalattá fejlődtünk: több mint 20 éve vagyunk jelen a beszállítói piacon, és 70 000 000 darab terméket értékesítettünk.', 'We started with 3 people in a 200 m² workshop. Today we are a stable company of 50 people: we have been in the supplier market for more than 20 years and have sold 70,000,000 parts.') }}</p>
      <p>{{ _('A géppark folyamatos bővítésével és fejlesztésével párhuzamosan új gyártócsarnokok épültek. Telephelyünk továbbra is Verpeléten van: egy 27 000 m²-es, saját tulajdonú ipari területen, 800 m²-es gyártóüzemmel és a 2016-ban uniós támogatással átadott, modern 1200 m²-es gyártócsarnokkal.', 'As the machine park was expanded and modernised, new production halls were built. We are still based in Verpelét: on a 27,000 m² company-owned industrial site with an 800 m² production plant and a modern 1,200 m² production hall opened in 2016 with EU funding.') }}</p>
      <p>{{ _('Termelésünk gerincét ' ~ totals.cnc_lathes ~ ' CNC eszterga és ' ~ totals.centres ~ ' megmunkálóközpont adja, NC csúcsesztergákkal és hagyományos gépekkel kiegészülve. A gyártás 3 műszakban történik. Cégünk vevőcentrikus: maximálisan törekszünk arra, hogy munkánk a lehető legjobb minőségben, a megadott határidőn belül és a vevői igényeknek minden téren megfeleljen.', 'Our production is built on ' ~ totals.cnc_lathes ~ ' CNC lathes and ' ~ totals.centres ~ ' machining centres, complemented by NC centre lathes and conventional machines. Production runs in 3 shifts. We are customer-centric: we strive to deliver the highest possible quality, on time and meeting customer requirements in every respect.') }}</p>
      <p>{{ _('A hazai és nemzetközi piac növekvő elvárásainak való megfelelés érdekében ISO 9001 minőségirányítási és ISO 14001 környezetirányítási rendszert, saját klimatizált mérőszobát, valamint SAP integrált vállalatirányítási rendszert működtetünk.', 'To meet the growing requirements of the domestic and international markets, we operate ISO 9001 quality management and ISO 14001 environmental management systems, our own air-conditioned measuring room and an integrated SAP ERP system.') }}</p>
    </div>
    <aside class="datasheet" aria-label="{{ _('Cégadatok', 'Company data') }}">
      <h2 class="datasheet__title">{{ _('Cégadatok', 'Company data') }}</h2>
      <dl>
        <div><dt>{{ _('Cégnév', 'Company name') }}</dt><dd>Steel Riders Kft.</dd></div>
        <div><dt>{{ _('Alapítás', 'Founded') }}</dt><dd>{{ _('1997. március', 'March 1997') }}</dd></div>
        <div><dt>{{ _('Ügyvezető', 'Managing director') }}</dt><dd>Farkas Gábor</dd></div>
        <div><dt>{{ _('Székhely', 'Registered office') }}</dt><dd>3351 Verpelét, Kossuth út 64.</dd></div>
        <div><dt>{{ _('Fő tevékenység', 'Main activity') }}</dt><dd>{{ _('2553 Fémmegmunkálás', '2553 Machining') }}</dd></div>
        <div><dt>{{ _('Munkatársak', 'Employees') }}</dt><dd>{{ _('50 fő', '50') }}</dd></div>
        <div><dt>{{ _('Munkarend', 'Operation') }}</dt><dd>{{ _('3 műszak', '3 shifts') }}</dd></div>
        <div><dt>{{ _('Telephely', 'Site') }}</dt><dd>27 000 m²</dd></div>
        <div><dt>{{ _('Gyártóterület', 'Production area') }}</dt><dd>800 m² + 1200 m²</dd></div>
        <div><dt>{{ _('Irányítási rendszerek', 'Management systems') }}</dt><dd>ISO 9001, ISO 14001</dd></div>
        <div><dt>{{ _('Adószám', 'VAT no.') }}</dt><dd>11174864-2-10</dd></div>
        <div><dt>{{ _('Cégjegyzékszám', 'Company reg. no.') }}</dt><dd>10-09-022629</dd></div>
      </dl>
    </aside>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Történet', 'History') }}</p>
        <h2 class="h2">{{ _('Mérföldkövek', 'Milestones') }}</h2>
      </div>
    </div>
    <ol class="timeline">
      <li>
        <time>1997</time>
        <div><h3 class="h3">{{ _('Alapítás', 'Foundation') }}</h3>
        <p>{{ _('Családi vállalkozásként indulunk Verpeléten 3 fővel, egy 200 m²-es műhelyben. Fő profil: fémforgácsolás, egyedi alkatrészek és sorozatgyártás.', 'We start as a family business in Verpelét with 3 people in a 200 m² workshop. Core profile: metal cutting, one-off parts and series production.') }}</p></div>
      </li>
      <li>
        <time>{{ _('Bővülés', 'Growth') }}</time>
        <div><h3 class="h3">{{ _('Saját telephely és gyártóüzem', 'Own site and production plant') }}</h3>
        <p>{{ _('A géppark bővülésével a gyártás egy 27 000 m²-es saját ipari területre, egy 800 m²-es gyártóüzembe költözik.', 'As the machine park grows, production moves to our own 27,000 m² industrial site and an 800 m² plant.') }}</p></div>
      </li>
      <li>
        <time>2012</time>
        <div><h3 class="h3">{{ _('SAP vállalatirányítás', 'SAP ERP') }}</h3>
        <p>{{ _('Uniós támogatással bevezetjük az átfogó SAP vállalatirányítási rendszert: automatizált gyártási és üzleti folyamatok.', 'With EU funding we introduce a comprehensive SAP ERP system: automated production and business processes.') }}</p></div>
      </li>
      <li>
        <time>2013</time>
        <div><h3 class="h3">{{ _('1100 m²-es gyártócsarnok', '1,100 m² production hall') }}</h3>
        <p>{{ _('Egy korábbi raktárcsarnokot termelőüzemmé alakítunk – a gyártási alapterület megduplázódik.', 'A former storage hall becomes a production plant – our production area doubles.') }}</p></div>
      </li>
      <li>
        <time>2016</time>
        <div><h3 class="h3">{{ _('Kapacitásbővítés – GINOP', 'Capacity expansion – GINOP') }}</h3>
        <p>{{ _('Csarnokfejlesztés, új CNC eszterga a nagyobb alkatrészekhez és képalkotásos profilmérő (GINOP-1.2.2-15-2015-01176).', 'Hall development, a new CNC lathe for larger parts and an imaging profile measuring system (GINOP-1.2.2-15-2015-01176).') }}</p></div>
      </li>
      <li>
        <time>2017</time>
        <div><h3 class="h3">{{ _('STAR SR-32J és 3D mérőgép', 'STAR SR-32J and 3D CMM') }}</h3>
        <p>{{ _('Újabb kapacitásbővítés: STAR SR-32J hosszeszterga, MICRO-3D CNC koordináta-mérőgép és teljes mérőeszköz-park.', 'Further capacity expansion: STAR SR-32J Swiss-type lathe, MICRO-3D CNC coordinate measuring machine and a complete set of gauges.') }}</p></div>
      </li>
      <li>
        <time>2018</time>
        <div><h3 class="h3">{{ _('Helikopterfejlesztés indul', 'Helicopter development starts') }}</h3>
        <p>{{ _('GINOP-projekt a kétszemélyes, hibrid meghajtású ultrakönnyű helikopter kifejlesztésére, AKIRA SEIKI SR42 XP megmunkálóközponttal.', 'GINOP project to develop the two-seat hybrid-powered ultralight helicopter, with an AKIRA SEIKI SR42 XP machining centre.') }}</p></div>
      </li>
      <li>
        <time>2020</time>
        <div><h3 class="h3">{{ _('Beszállítói fejlesztés – Irinyi Terv', 'Supplier development – Irinyi Plan') }}</h3>
        <p>{{ _('2 db STAR SB-20RG hosszeszterga, termelésirányítási rendszer és képzés – beszállítói megállapodással az integrátorral.', '2 STAR SB-20RG Swiss-type lathes, a production management system and training – with a supplier agreement with the integrator.') }}</p></div>
      </li>
      <li>
        <time>2021</time>
        <div><h3 class="h3">{{ _('Napelem, AKIRA SEIKI V4 XP, HC-02.2', 'Solar PV, AKIRA SEIKI V4 XP, HC-02.2') }}</h3>
        <p>{{ _('48,96 kWp napelemes rendszer; GINOP-1.2.8 projekt AKIRA SEIKI V4 XP megmunkálóközponttal, FiberSX lézeregységgel és kontúrmérővel. Június 8-án a HC-02.2 helikopter megkapja a tesztrepülési engedélyeket.', '48.96 kWp solar PV system; GINOP-1.2.8 project with an AKIRA SEIKI V4 XP machining centre, FiberSX laser unit and contour measuring instrument. On 8 June the HC-02.2 helicopter receives its test flight permits.') }}</p></div>
      </li>
      <li>
        <time>{{ year }}</time>
        <div><h3 class="h3">{{ _('Ma', 'Today') }}</h3>
        <p>{{ _(totals.all ~ ' gép – köztük ' ~ totals.cnc_lathes ~ ' CNC eszterga és ' ~ totals.centres ~ ' megmunkálóközpont –, 50 munkatárs, 3 műszak és 70 000 000 eladott termék.', totals.all ~ ' machines – including ' ~ totals.cnc_lathes ~ ' CNC lathes and ' ~ totals.centres ~ ' machining centres –, 50 employees, 3 shifts and 70,000,000 parts sold.') }}</p></div>
      </li>
    </ol>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ _('Amiben hiszünk', 'What we stand for') }}</p>
        <h2 class="h2">{{ _('Hogyan dolgozunk', 'How we work') }}</h2>
      </div>
    </div>
    <div class="values">
      <div><h3 class="h3">{{ _('Egy kézben', 'Single source') }}</h3><p>{{ _('Az alapanyag-beszerzéstől a kiszállításig egy kézben kezeljük a gyártást, ez csökkenti partnereink logisztikai költségeit.', 'We handle manufacturing in one hand from material sourcing to delivery, reducing our partners’ logistics costs.') }}</p></div>
      <div><h3 class="h3">{{ _('Mérhető minőség', 'Measurable quality') }}</h3><p>{{ _('Tanúsított irányítási rendszerek, saját mérőszoba és dokumentált ellenőrzés.', 'Certified management systems, our own measuring room and documented inspection.') }}</p></div>
      <div><h3 class="h3">{{ _('Folyamatos fejlesztés', 'Continuous improvement') }}</h3><p>{{ _('Rendszeresen bővítjük gépparkunkat, és fejlesztjük gyártásirányítási rendszereinket.', 'We regularly expand our machine park and develop our production management systems.') }}</p></div>
      <div><h3 class="h3">{{ _('Helyi munkahely', 'Local employer') }}</h3><p>{{ _('Családi vállalkozásként Verpelét és a környék stabil munkáltatója vagyunk.', 'As a family business we are a stable employer in Verpelét and the surrounding region.') }}</p></div>
    </div>
  </div>
</section>

{% endblock %}
