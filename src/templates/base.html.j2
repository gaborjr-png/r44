<!doctype html>
<html lang="{{ lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  {% if page == 'notfound' %}<base href="{{ '/' if lang == 'hu' else '/en/' }}">{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% block title %}{% endblock %} | Steel Riders Kft.</title>
  <meta name="description" content="{% block description %}{{ description }}{% endblock %}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ hu_url if lang == 'hu' else en_url }}">
  <meta name="theme-color" content="#0f1419">
  <link rel="alternate" hreflang="hu" href="{{ hu_url }}">
  <link rel="alternate" hreflang="en" href="{{ en_url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Steel Riders Kft.">
  <meta property="og:title" content="{{ self.title() }} | Steel Riders Kft.">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ hu_url if lang == 'hu' else en_url }}">
  <meta property="og:image" content="{{ site_url }}/assets/img/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:locale" content="{{ _('hu_HU', 'en_GB') }}">
  <link rel="icon" href="{{ asset }}img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
  <link rel="stylesheet" href="{{ asset }}css/site.css">
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <script>
  /* New page → start at the top (keeps #anchor links and Back/Forward position) */
  (function () {
    var nav = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
    if (location.hash || (nav && nav.type === 'back_forward')) return;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    var top = function () { var h = document.documentElement, b = h.style.scrollBehavior; h.style.scrollBehavior = 'auto'; window.scrollTo(0, 0); h.style.scrollBehavior = b; };
    top();
    document.addEventListener('DOMContentLoaded', top);
    window.addEventListener('load', function () { if (window.scrollY < 400) top(); });
  })();
  </script>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"LocalBusiness","@id":"{{ site_url }}/#org","name":"Steel Riders Kft.","description":"{{ description }}","url":"{{ site_url }}/","logo":"{{ site_url }}/assets/img/logo-badge.webp","image":"{{ site_url }}/assets/img/og.jpg","foundingDate":"1997-03","email":"info1@steelriderskft.hu","telephone":"+36 36 494 183","faxNumber":"+36 36 359 494","taxID":"11174864-2-10","numberOfEmployees":50,"address":{"@type":"PostalAddress","streetAddress":"Kossuth út 64.","postalCode":"3351","addressLocality":"Verpelét","addressRegion":"Heves","addressCountry":"HU"},"geo":{"@type":"GeoCoordinates","latitude":47.85,"longitude":20.23},"hasMap":"{{ site.maps_url }}","sameAs":["https://www.facebook.com/steelriderskft/"],"knowsAbout":["CNC turning","CNC milling","Series production","Swiss-type turning"]}
  </script>
</head>
<body class="page-{{ page }}" data-ga="{{ site.ga4 }}">
  <a class="skip" href="#main">{{ _('Ugrás a tartalomhoz', 'Skip to content') }}</a>
  <div class="progress" aria-hidden="true"><span id="scrollProgress"></span></div>

  <header class="header" id="header">
    <div class="wrap header__inner">
      <a class="brand" href="{{ href('home') }}" aria-label="Steel Riders Kft. – {{ _('Főoldal', 'Home') }}">
        <svg class="brand__mark" viewBox="0 0 48 44" aria-hidden="true">
          <path class="brand__badge" d="M24 2.5c1.6 0 2.9.8 3.8 2.3l17 29.2c1.9 3.3.1 6.2-3.6 6.9-5.4 1-11 1.5-17.2 1.5S12.2 41.9 6.8 40.9c-3.7-.7-5.5-3.6-3.6-6.9l17-29.2c.9-1.5 2.2-2.3 3.8-2.3z"/>
          <path class="brand__rim" d="M24 6.2c.9 0 1.6.5 2.1 1.3l15.6 26.8c1 1.8.2 3.2-1.9 3.6-5 .9-10.2 1.4-15.8 1.4s-10.8-.5-15.8-1.4c-2.1-.4-2.9-1.8-1.9-3.6L22 7.5c.5-.8 1.2-1.3 2-1.3z"/>
          <text x="24" y="24.2" text-anchor="middle" class="brand__t">STEEL</text>
          <path d="M13.5 26.2h21" class="brand__rule"/>
          <text x="24" y="33.4" text-anchor="middle" class="brand__t">RIDERS</text>
        </svg>
        <span class="brand__name">Steel Riders<small>Kft. · {{ _('CNC forgácsolás', 'CNC machining') }}</small></span>
      </a>

      <nav class="nav" id="nav" aria-label="{{ _('Fő navigáció', 'Main navigation') }}">
        <ul class="nav__list">
          {% for item in nav %}
          <li><a href="{{ item.href }}"{% if item.key == page %} aria-current="page"{% endif %}><span class="nav__idx">{{ '%02d' % loop.index }}</span>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
        <div class="nav__foot">
          <a href="tel:+3636494183">+36 36 494 183</a>
          <a href="mailto:info1@steelriderskft.hu">info1@steelriderskft.hu</a>
          <span>3351 Verpelét, Kossuth út 64.</span>
        </div>
      </nav>

      <div class="header__tools">
        <div class="langs" role="group" aria-label="{{ _('Nyelv', 'Language') }}">
          {% if lang == 'hu' %}
          <span aria-current="true">HU</span><a href="{{ alt_href }}" hreflang="en" lang="en">EN</a>
          {% else %}
          <a href="{{ alt_href }}" hreflang="hu" lang="hu">HU</a><span aria-current="true">EN</span>
          {% endif %}
        </div>
        <a class="btn btn--brass btn--sm header__cta" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatkérés', 'Request a quote') }}</a>
        <button class="menu-btn" id="menuBtn" type="button" aria-controls="nav" aria-expanded="false">
          <span class="menu-btn__bars" aria-hidden="true"></span>
          <span class="sr-only">{{ _('Menü', 'Menu') }}</span>
        </button>
      </div>
    </div>
  </header>

  <a class="fab" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatkérés', 'Get a quote') }}</a>
  <main id="main">
    {% block content %}{% endblock %}
  </main>

  {% if page != 'contact' %}
  <section class="cta-band">
    <div class="cta-band__grid" aria-hidden="true"></div>
    <div class="wrap cta-band__inner">
      <div>
        <p class="eyebrow eyebrow--light">{{ _('Ajánlatkérés', 'Request for quotation') }}</p>
        <h2 class="cta-band__title">{{ _('Küldje el műszaki rajzát, és személyre szabott ajánlattal jelentkezünk.', 'Send us your technical drawing and we will get back to you with a tailored quotation.') }}</h2>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--brass btn--lg" href="{{ href('contact') }}#ajanlatkeres">{{ _('Ajánlatot kérek', 'Request a quote') }}<span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="cta-band__phone" href="tel:+36303828398"><span>{{ _('vagy hívjon', 'or call') }}</span>+36 30 382 8398</a>
      </div>
    </div>
  </section>
  {% endif %}

  <footer class="footer">
    <div class="wrap footer__grid">
      <div class="footer__brand">
        <img class="footer__logo" src="{{ asset }}img/logo-badge.webp" alt="Steel Riders Kft." width="120" height="120" loading="lazy">
        <p>{{ _('Precíziós CNC esztergálás és marás közép- és nagysorozatban. Beszállító 1997 óta.', 'Precision CNC turning and milling in medium and large series. Supplier since 1997.') }}</p>
        <ul class="footer__certs">
          <li><a href="{{ href('quality') }}#tanusitvanyok">ISO 9001</a></li><li><a href="{{ href('quality') }}#tanusitvanyok">ISO 14001</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__h">{{ _('Vállalat', 'Company') }}</h2>
        <ul class="footer__list">
          <li><a href="{{ href('about') }}">{{ _('Rólunk', 'About us') }}</a></li>
          <li><a href="{{ href('quality') }}">{{ _('Minőség', 'Quality') }}</a></li>
          <li><a href="{{ href('hc02') }}">{{ _('HC-02 helikopter', 'HC-02 helicopter') }}</a></li>
          <li><a href="{{ href('careers') }}">{{ _('Karrier', 'Careers') }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__h">{{ _('Gyártás', 'Manufacturing') }}</h2>
        <ul class="footer__list">
          <li><a href="{{ href('services') }}#esztergalas">{{ _('CNC esztergálás', 'CNC turning') }}</a></li>
          <li><a href="{{ href('services') }}#maras">{{ _('CNC marás', 'CNC milling') }}</a></li>
          <li><a href="{{ href('services') }}#ontveny">{{ _('Öntvény-megmunkálás', 'Casting machining') }}</a></li>
          <li><a href="{{ href('machinery') }}">{{ _('Géppark', 'Machinery') }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__h">{{ _('Kapcsolat', 'Contact') }}</h2>
        <address class="footer__addr">
          Steel Riders Kft.<br>
          3351 Verpelét, Kossuth út 64.<br>
          {{ _('Magyarország', 'Hungary') }}<br>
          <a href="tel:+3636494183">+36 36 494 183</a><br>
          Fax: +36 36 359 494<br>
          <a href="mailto:info1@steelriderskft.hu">info1@steelriderskft.hu</a>
        </address>
      </div>
    </div>
    <div class="wrap footer__legal">
      <span>© {{ year }} Steel Riders Kft.</span>
      <span>{{ _('Adószám', 'VAT no.') }}: 11174864-2-10</span>
      <span>{{ _('Cégjegyzékszám', 'Company reg. no.') }}: 10-09-022629</span>
      <a href="{{ href('imprint') }}">{{ _('Impresszum', 'Imprint') }}</a>
      <a href="{{ href('privacy') }}">{{ _('Adatvédelem', 'Privacy') }}</a>
      <a href="{{ href('privacy') }}#sutik" data-cookie-settings>{{ _('Süti-beállítások', 'Cookie settings') }}</a>
      <a href="https://www.facebook.com/steelriderskft/" rel="noopener" target="_blank">Facebook</a>
      <a class="footer__top" href="#main">{{ _('Vissza a tetejére', 'Back to top') }} ↑</a>
    </div>
  </footer>

  <div class="cookie" id="cookie" role="dialog" aria-labelledby="ckTitle" aria-live="polite" hidden>
    <div class="cookie__main">
      <p class="cookie__title" id="ckTitle">{{ _('Sütik a weboldalon', 'Cookies on this website') }}</p>
      <p>{{ _('A weboldal működéséhez szükséges sütiket mindig használjuk. Az Ön hozzájárulásával látogatottsági statisztikát is készítünk, és betöltjük a Google Térképet.', 'We always use the cookies needed for the site to work. With your consent we also collect visitor statistics and load Google Maps.') }} <a href="{{ href('privacy') }}#sutik">{{ _('Részletek', 'Details') }}</a></p>
    </div>
    <div class="cookie__detail">
      <label class="check check--on"><input type="checkbox" checked disabled> <span><b>{{ _('Szükséges', 'Necessary') }}</b> — {{ _('nyelv, beállítások mentése', 'language, saving your settings') }}</span></label>
      <label class="check"><input type="checkbox" id="ckStats"> <span><b>{{ _('Statisztika', 'Statistics') }}</b> — {{ _('Google Analytics, anonimizált IP-címmel', 'Google Analytics with anonymised IP') }}</span></label>
      <label class="check"><input type="checkbox" id="ckMaps"> <span><b>{{ _('Külső tartalom', 'External content') }}</b> — {{ _('beágyazott Google Térkép', 'embedded Google Maps') }}</span></label>
    </div>
    <div class="cookie__actions">
      <button class="btn btn--text" type="button" id="ckMore">{{ _('Beállítások', 'Settings') }}</button>
      <button class="btn btn--outline" type="button" id="ckNone">{{ _('Csak a szükségesek', 'Necessary only') }}</button>
      <button class="btn btn--outline cookie__save" type="button" id="ckSave">{{ _('Kiválasztottak mentése', 'Save selection') }}</button>
      <button class="btn btn--brass" type="button" id="ckAll">{{ _('Összes elfogadása', 'Accept all') }}</button>
    </div>
  </div>

  <script src="{{ asset }}vendor/three.min.js" defer></script>
  <script src="{{ asset }}vendor/three-post.js" defer></script>
  <script src="{{ asset }}js/part3d.js" defer></script>
  <script src="{{ asset }}js/site.js" defer></script>
</body>
</html>
