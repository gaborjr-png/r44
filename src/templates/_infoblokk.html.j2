{# Official Széchenyi 2020 infoblokk, transparent background.
   With infoblokk_float: floats in the bottom-right corner of the home page (visible without scrolling);
   It uses the negative version on a dark glass panel, so it looks the same over every section. #}
{% if infoblokk_float is defined %}
<a class="infoblokk infoblokk--float" href="{{ href('projects') }}#szechenyi">
  <img src="{{ asset }}img/infoblokk-szechenyi2020-negativ.webp" width="800" height="560" alt="{{ _('Széchenyi 2020 – Magyarország Kormánya, Európai Unió, Európai Regionális Fejlesztési Alap. Befektetés a jövőbe.', 'Széchenyi 2020 – Government of Hungary, European Union, European Regional Development Fund. Investing in your future.') }}" fetchpriority="high">
</a>
{% else %}
<a class="infoblokk" href="{{ href('projects') }}#szechenyi">
  <img src="{{ asset }}img/infoblokk-szechenyi2020.webp" width="800" height="560" alt="{{ _('Széchenyi 2020 – Magyarország Kormánya, Európai Unió, Európai Regionális Fejlesztési Alap. Befektetés a jövőbe.', 'Széchenyi 2020 – Government of Hungary, European Union, European Regional Development Fund. Investing in your future.') }}" loading="lazy">
</a>
{% endif %}
