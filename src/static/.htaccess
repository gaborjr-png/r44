# Steel Riders Kft. – web server settings (Apache / LiteSpeed, cPanel)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Custom error page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS and the address without "www"
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://steelriderskft.hu%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://steelriderskft.hu%{REQUEST_URI} [L,R=301]

  # Old website addresses → new pages (keeps Google rankings and old links)
  RewriteRule ^hu/?$ / [L,R=301]
  RewriteRule ^hu/rolunk/?$ /rolunk.html [L,R=301]
  RewriteRule ^hu/kapcsolat/?$ /kapcsolat.html [L,R=301]
  RewriteRule ^hu/geppark/?$ /geppark.html [L,R=301]
  RewriteRule ^hu/(tevekenyseg|tevekenysegek|szolgaltatasok)/?$ /tevekenysegek.html [L,R=301]
  RewriteRule ^hu/(minoseg|minosegugy)/?$ /minosegugy.html [L,R=301]
  RewriteRule ^hu/(ginop|palyazatok|projektek|beruhazasok)/?$ /projektek.html [L,R=301]
  RewriteRule ^hu/(karrier|allas)/?$ /karrier.html [L,R=301]
  RewriteRule ^hu/(helikopter|hungarocopter)/?$ /helikopter.html [L,R=301]
  RewriteRule ^hu/.+$ / [L,R=301]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# Browser caching (CSS/JS carry a version number, so they can be cached long)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
